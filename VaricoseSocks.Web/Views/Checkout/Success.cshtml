@model VaricoseSocks.Web.Models.OrderDetailViewModel
@{
    ViewData["Title"] = "Đặt hàng thành công - Mã " + Model.OrderCode;
}

<div class="container py-5">
    <div class="glass-card bg-white p-4 p-md-5 border shadow-subtle mx-auto text-center position-relative overflow-hidden" style="max-width: 780px;">
        <!-- Top Confetti trigger & Checkmark -->
        <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 76px; height: 76px;">
            <i class="bi bi-check-lg fs-1"></i>
        </div>
        
        <h2 class="fw-bold text-success mb-2">ĐẶT HÀNG THÀNH CÔNG!</h2>
        <p class="text-muted">Cảm ơn bạn đã tin tưởng điều trị suy giãn tĩnh mạch cùng Varicose Socks.</p>
        
        <div class="badge bg-primary fs-5 px-4 py-2 rounded-pill mb-4 shadow-sm">
            Mã đơn hàng: @Model.OrderCode
        </div>

        <!-- Order Information Box -->
        <div class="bg-light p-4 rounded-4 mb-4 border text-start">
            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle me-1"></i>Thông tin đơn hàng & giao nhận:</h6>
            <div class="row g-3 small">
                <div class="col-sm-6">
                    <span class="text-muted d-block">Người nhận vớ:</span>
                    <strong class="text-dark fs-6">@Model.CustomerName</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Số điện thoại:</span>
                    <strong class="text-dark fs-6">@Model.CustomerPhone</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Email thông báo:</span>
                    <strong class="text-dark">@Model.CustomerEmail</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Phương thức thanh toán:</span>
                    <strong class="text-primary">@Model.PaymentMethodText</strong>
                </div>
                <div class="col-12">
                    <span class="text-muted d-block">Địa chỉ nhận hàng:</span>
                    <strong class="text-dark">@Model.ShippingAddress, @(Model.District ?? ""), @(Model.City ?? "TP.HCM")</strong>
                </div>
            </div>
        </div>

        @if (Model.PaymentMethodText.Contains("VietQR") || Model.PaymentMethodText.Contains("Chuyển khoản"))
        {
            <div class="p-4 bg-white rounded-4 border shadow-subtle mb-4">
                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-qr-code-scan me-1"></i>Quét mã VietQR chuyển khoản thanh toán:</h6>
                <div class="qr-card-wrapper d-inline-block mb-3">
                    <div class="radar-laser"></div>
                    <img src="https://api.vietqr.io/image/970422-0987654321-compact.jpg?amount=@Model.TotalAmount&addInfo=@Model.OrderCode&accountName=VARICOSE%20SOCKS" 
                         style="width: 200px; height: 200px; object-fit: contain;" alt="Mã VietQR" />
                </div>
                <div class="small text-muted">
                    Ngân hàng: <strong>MBBank</strong> | STK: <strong>0987.654.321</strong> | Nội dung chuyển khoản: <strong class="text-danger">@Model.OrderCode</strong>
                </div>
            </div>
        }

        <!-- Items Purchased List -->
        <div class="text-start mb-4">
            <h6 class="fw-bold text-dark mb-3">Sản phẩm trong đơn:</h6>
            <div class="list-group list-group-flush border rounded-4 overflow-hidden">
                @foreach (var item in Model.Items)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3 bg-white">
                        <div class="d-flex align-items-center">
                            <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "/images/products/vo-goi-jobst-ccl2.svg" : item.ProductImageUrl)" 
                                 class="rounded-3 border p-1 me-3 bg-light" style="width: 48px; height: 48px; object-fit: contain;" />
                            <div>
                                <div class="fw-bold text-dark">@item.ProductName</div>
                                <small class="text-muted">Size: <span class="badge bg-light text-dark border">@item.Size</span> | Màu: @item.Color | SL: @item.Quantity</small>
                            </div>
                        </div>
                        <div class="text-danger fw-bold">
                            @item.TotalPrice.ToString("N0") ₫
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-baseline mb-4 p-3 bg-light rounded-4 border">
            <span class="fs-5 fw-bold text-dark">Tổng tiền thanh toán:</span>
            <span class="fs-3 fw-bold text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a asp-controller="Order" asp-action="Track" asp-route-query="@Model.OrderCode" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-truck me-1"></i> Theo dõi hành trình đơn hàng
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                <i class="bi bi-house me-1"></i> Quay về trang chủ
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        triggerConfetti();
    });
</script>
}
