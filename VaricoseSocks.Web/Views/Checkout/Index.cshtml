@model VaricoseSocks.Web.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng vớ y khoa - Varicose Socks";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none">Giỏ hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh toán & Giao nhận</li>
        </ol>
    </nav>

    <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-2">BƯỚC 2: THANH TOÁN AN TOÀN</span>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-shield-check me-2"></i>Thông Tin Giao Nhận & Thanh Toán
        </h2>
        <p class="text-muted small">Cam kết bảo mật thông tin y tế bệnh nhân 100%.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0 mb-4" role="alert">
            <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Vui lòng kiểm tra lại thông tin:</h6>
            <div asp-validation-summary="All" class="small"></div>
        </div>
    }

    <form asp-controller="Checkout" asp-action="Process" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="VoucherCode" id="hiddenVoucherCode" />

        <div class="row g-4">
            <!-- Left: Shipping info & Payment method -->
            <div class="col-lg-7">
                <!-- Shipping Details Card -->
                <div class="glass-card bg-white p-4 mb-4 border shadow-subtle">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-geo-alt-fill text-primary me-2"></i>1. Địa chỉ nhận vớ y khoa
                    </h5>

                    <div class="alert alert-warning-subtle text-dark border-warning-subtle rounded-4 p-3 small mb-3">
                        <i class="bi bi-shield-exclamation text-warning me-1"></i>
                        <strong>Ràng buộc giao hàng y tế:</strong> Quý khách bắt buộc cung cấp chính xác <strong>Số điện thoại</strong> và <strong>Địa chỉ nhận hàng</strong> để nhân viên y tế liên hệ xác nhận size vớ và giao hàng tận nhà.
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="CustomerName" class="form-control rounded-pill px-3" placeholder="Nguyễn Văn A" required />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerPhone" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="CustomerPhone" class="form-control rounded-pill px-3" placeholder="0901234567" required />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CustomerEmail" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="CustomerEmail" class="form-control rounded-pill px-3" placeholder="email@example.com" type="email" required />
                            <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                            <div class="form-text small" style="font-size: 0.75rem;">Mã vận đơn và hóa đơn điện tử sẽ được gửi về email này.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="ShippingAddress" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="ShippingAddress" class="form-control rounded-pill px-3" placeholder="Số nhà, tên tòa nhà, tên đường, phường/xã..." required />
                            <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="City" class="form-control rounded-pill px-3" placeholder="TP. Hồ Chí Minh" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="District" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="District" class="form-control rounded-pill px-3" placeholder="Quận 1, Quận 3, Bình Thạnh..." />
                        </div>

                        <div class="col-12">
                            <label asp-for="Note" class="form-label small fw-bold text-muted"></label>
                            <textarea asp-for="Note" class="form-control rounded-4 px-3" rows="2" placeholder="Ghi chú giao hàng (Ví dụ: Giao giờ hành chính, gọi trước khi đến...)"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Payment Method Card with VietQR laser radar -->
                <div class="glass-card bg-white p-4 border shadow-subtle">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-wallet2 text-primary me-2"></i>2. Phương thức thanh toán
                    </h5>

                    <div class="d-flex flex-column gap-3 mb-3">
                        <label class="form-check p-3 border rounded-4 bg-light d-flex align-items-center cursor-pointer transition-hover">
                            <input class="form-check-input me-3" type="radio" asp-for="PaymentMethod" value="1" checked onchange="toggleQrCard(false)" />
                            <div class="flex-grow-1">
                                <strong class="d-block text-dark"><i class="bi bi-cash-stack text-success me-2"></i>Thanh toán khi nhận hàng (COD)</strong>
                                <small class="text-muted">Nhận bưu kiện, kiểm tra đúng size và loại vớ y khoa rồi mới thanh toán tiền mặt cho nhân viên giao hàng.</small>
                            </div>
                        </label>

                        <label class="form-check p-3 border rounded-4 bg-light d-flex align-items-center cursor-pointer transition-hover">
                            <input class="form-check-input me-3" type="radio" asp-for="PaymentMethod" value="2" onchange="toggleQrCard(true)" />
                            <div class="flex-grow-1">
                                <strong class="d-block text-dark"><i class="bi bi-qr-code text-primary me-2"></i>Chuyển khoản VietQR Siêu Tốc (Vietcombank)</strong>
                                <small class="text-muted">Nhấn Đặt hàng để mở Cổng quét mã VietQR Napas247 (hiệu lực 15 phút) qua bất kỳ App Ngân hàng nào.</small>
                            </div>
                        </label>
                    </div>

                    <!-- VietQR Information notice -->
                    <div id="vietQrSection" class="p-3 bg-light rounded-4 border d-none">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-success px-3 py-1 rounded-pill"><i class="bi bi-bank me-1"></i> Vietcombank</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small">Napas247 Siêu Tốc</span>
                        </div>
                        <div class="small text-muted mb-2">
                            <i class="bi bi-qr-code-scan text-primary me-1"></i>Khi bạn nhấn <strong>"Tiến Hành Quét Mã Thanh Toán"</strong>, màn hình Cổng thanh toán VietQR sẽ hiển thị kèm đồng hồ đếm ngược <strong>15 phút</strong> để bạn quét mã thanh toán bằng App Ngân hàng.
                        </div>
                        <div class="bg-white p-2 rounded-3 border small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Tài khoản thụ hưởng:</span>
                                <strong class="text-dark">Vietcombank - 9379798265 (CHU VAN QUOC TRUNG)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="col-lg-5">
                <div class="glass-card bg-white p-4 sticky-top border shadow-subtle" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3">Đơn hàng của bạn (@Model.Cart.TotalQuantity đôi vớ)</h5>

                    <!-- Items list -->
                    <div class="d-flex flex-column gap-3 mb-3 overflow-y-auto" style="max-height: 250px;">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between pb-2 border-bottom">
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "/images/products/vo-goi-jobst-ccl2.svg" : item.ProductImageUrl)" 
                                         class="rounded-3 me-2 border p-1 bg-light" style="width: 48px; height: 48px; object-fit: contain;" />
                                    <div>
                                        <div class="fw-bold small text-dark text-truncate" style="max-width: 170px;">@item.ProductName</div>
                                        <small class="text-muted">Size: @item.Size | SL: @item.Quantity</small>
                                    </div>
                                </div>
                                <div class="text-danger fw-bold small text-nowrap">
                                    @item.TotalPrice.ToString("N0") ₫
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Single Clean Voucher Input Box -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted"><i class="bi bi-ticket-perforated-fill text-primary me-1"></i>Mã giảm giá / Voucher</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="voucherInput" class="form-control rounded-start-pill text-uppercase" placeholder="Nhập mã (Vd: VARICOSE10)" value="@Model.VoucherCode" />
                            <button class="btn btn-primary rounded-end-pill px-3 fw-bold" type="button" onclick="applyVoucher()">Áp dụng</button>
                        </div>
                        <div class="d-flex gap-1 mt-2">
                            <button type="button" class="badge bg-light text-primary border rounded-pill px-2 py-1 small" onclick="fillVoucher('VARICOSE10')">
                                + VARICOSE10 (-10%)
                            </button>
                            <button type="button" class="badge bg-light text-success border rounded-pill px-2 py-1 small" onclick="fillVoucher('FREESHIP')">
                                + FREESHIP
                            </button>
                        </div>
                        <div id="voucherMessage" class="small mt-2" style="display: none;"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-bold" id="summarySubTotal" data-value="@Model.Cart.SubTotal">@Model.Cart.SubTotal.ToString("N0") ₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Phí vận chuyển:</span>
                        @if (Model.Cart.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold" id="summaryShipping">Miễn phí toàn quốc</span>
                        }
                        else
                        {
                            <span class="fw-bold" id="summaryShipping" data-value="@Model.Cart.ShippingFee">@Model.Cart.ShippingFee.ToString("N0") ₫</span>
                        }
                    </div>

                    <div id="discountRow" class="d-flex justify-content-between align-items-center mb-2 small text-success" style="display: @(Model.DiscountAmount > 0 ? "flex" : "none") !important;">
                        <span>
                            <i class="bi bi-tag-fill me-1"></i>Ưu đãi giảm giá:
                            <button type="button" class="btn btn-link text-danger p-0 ms-1 small" onclick="removeVoucher()" title="Hủy mã này" style="font-size: 0.75rem; text-decoration: none;">[Bỏ mã]</button>
                        </span>
                        <span class="fw-bold" id="summaryDiscount">-@Model.DiscountAmount.ToString("N0") ₫</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold text-dark">Tổng cộng:</span>
                        <span class="fs-4 fw-bold text-danger" id="summaryTotal">@((Model.Cart.TotalAmount - Model.DiscountAmount).ToString("N0")) ₫</span>
                    </div>

                    <button type="submit" id="btnPlaceOrder" class="btn btn-warning btn-lg w-100 fw-bold text-dark rounded-pill shadow-glow-warning py-3">
                        <i class="bi bi-check-circle-fill me-2" id="btnPlaceOrderIcon"></i>
                        <span id="btnPlaceOrderText">Xác Nhận Đặt Hàng Ngay (COD)</span>
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        <i class="bi bi-shield-check text-success me-1"></i> Đổi size miễn phí trong 7 ngày nếu không vừa chân
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function toggleQrCard(isVietQr) {
        const qrEl = document.getElementById('vietQrSection');
        const btn = document.getElementById('btnPlaceOrder');
        const btnText = document.getElementById('btnPlaceOrderText');
        const btnIcon = document.getElementById('btnPlaceOrderIcon');

        if (qrEl) {
            if (isVietQr) {
                qrEl.classList.remove('d-none');
            } else {
                qrEl.classList.add('d-none');
            }
        }

        if (btn && btnText && btnIcon) {
            if (isVietQr) {
                btn.className = 'btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm py-3 text-white';
                btnIcon.className = 'bi bi-qr-code-scan me-2';
                btnText.innerText = 'Tiến Hành Quét Mã Thanh Toán VietQR (15 Phút)';
            } else {
                btn.className = 'btn btn-warning btn-lg w-100 fw-bold text-dark rounded-pill shadow-glow-warning py-3';
                btnIcon.className = 'bi bi-check-circle-fill me-2';
                btnText.innerText = 'Xác Nhận Đặt Hàng Ngay (COD)';
            }
        }
    }

    function fillVoucher(code) {
        const input = document.getElementById('voucherInput');
        if (input) {
            input.value = code;
            applyVoucher();
        }
    }

    function removeVoucher() {
        const input = document.getElementById('voucherInput');
        if (input) input.value = '';
        document.getElementById('hiddenVoucherCode').value = '';
        
        const msgEl = document.getElementById('voucherMessage');
        if (msgEl) {
            msgEl.innerText = '';
            msgEl.style.display = 'none';
        }

        document.getElementById('discountRow').style.setProperty('display', 'none', 'important');
        document.getElementById('summaryDiscount').innerText = '-0 ₫';

        const subTotalEl = document.getElementById('summarySubTotal');
        const subTotal = subTotalEl ? parseFloat(subTotalEl.getAttribute('data-value')) : 0;
        const shipping = subTotal >= 500000 ? 0 : 30000;
        const finalTotal = subTotal + shipping;
        document.getElementById('summaryTotal').innerText = `${Number(finalTotal).toLocaleString('vi-VN')} ₫`;

        const qrAmtEl = document.getElementById('qrAmountDisplay');
        if (qrAmtEl) qrAmtEl.innerText = `${Number(finalTotal).toLocaleString('vi-VN')} ₫`;

        const qrImg = document.getElementById('qrImagePreview');
        if (qrImg) {
            qrImg.src = `https://api.vietqr.io/image/970436-9379798265-compact2.jpg?amount=${finalTotal}&addInfo=VS2026&accountName=CHU%20VAN%20QUOC%20TRUNG`;
        }
    }

    async function applyVoucher() {
        const codeInput = document.getElementById('voucherInput');
        const code = codeInput ? codeInput.value.trim() : '';
        const msgEl = document.getElementById('voucherMessage');
        const subTotalEl = document.getElementById('summarySubTotal');
        const subTotal = subTotalEl ? parseFloat(subTotalEl.getAttribute('data-value')) : 0;

        if (!code) {
            msgEl.className = 'small mt-2 text-danger';
            msgEl.innerText = 'Vui lòng nhập mã giảm giá.';
            msgEl.style.display = 'block';
            return;
        }

        // Gọi trực tiếp RESTful API Promotions Backend (port 5046) để hiển thị trên DevTools Network Fetch/XHR
        try {
            console.log('[DevTools Network Fetch/XHR] 🚀 Gửi POST: http://localhost:5046/api/promotions/validate');
            fetch('http://localhost:5046/api/promotions/validate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code, orderAmount: subTotal })
            }).then(r => r.json()).then(d => {
                console.log('[DevTools Network Fetch/XHR] ✅ Kiểm tra voucher từ API 5046:', d);
            }).catch(e => console.log('API voucher check:', e));
        } catch {}

        try {
            const resp = await fetch('/Checkout/ValidateVoucher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code, orderAmount: subTotal })
            });
            const data = await resp.json();

            if (data.success) {
                document.getElementById('hiddenVoucherCode').value = data.code;
                msgEl.className = 'small mt-2 text-success fw-bold';
                msgEl.innerText = data.message;
                msgEl.style.display = 'block';

                document.getElementById('discountRow').style.setProperty('display', 'flex', 'important');
                document.getElementById('summaryDiscount').innerText = `-${Number(data.discountAmount).toLocaleString('vi-VN')} ₫`;

                const shipping = subTotal >= 500000 ? 0 : 30000;
                const finalTotal = Math.max(0, subTotal + shipping - data.discountAmount);
                document.getElementById('summaryTotal').innerText = `${Number(finalTotal).toLocaleString('vi-VN')} ₫`;
                
                const qrAmtEl = document.getElementById('qrAmountDisplay');
                if (qrAmtEl) qrAmtEl.innerText = `${Number(finalTotal).toLocaleString('vi-VN')} ₫`;

                const qrImg = document.getElementById('qrImagePreview');
                if (qrImg) {
                    qrImg.src = `https://api.vietqr.io/image/970436-9379798265-compact2.jpg?amount=${finalTotal}&addInfo=VS2026&accountName=CHU%20VAN%20QUOC%20TRUNG`;
                }

                if (typeof triggerConfetti === 'function') triggerConfetti();
            } else {
                msgEl.className = 'small mt-2 text-danger';
                msgEl.innerText = data.message || 'Mã không hợp lệ.';
                msgEl.style.display = 'block';
            }
        } catch (e) {
            msgEl.className = 'small mt-2 text-danger';
            msgEl.innerText = 'Lỗi kết nối khi kiểm tra mã.';
            msgEl.style.display = 'block';
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Tải thông tin giỏ hàng từ RESTful API 5046 để hiển thị trên DevTools Network
        try {
            const sid = typeof getOrCreateClientSessionId === 'function' ? getOrCreateClientSessionId() : '';
            console.log('[DevTools Network Fetch/XHR] 🚀 Gửi HTTP GET: http://localhost:5046/api/cart?sessionId=' + sid);
            fetch('http://localhost:5046/api/cart?sessionId=' + encodeURIComponent(sid))
                .then(r => r.json())
                .then(d => console.log('[DevTools Network Fetch/XHR] ✅ Dữ liệu giỏ hàng Checkout từ API 5046:', d))
                .catch(e => console.log('Cart Checkout fetch:', e));
        } catch {}

        const initCode = document.getElementById('voucherInput')?.value?.trim();
        if (initCode) {
            applyVoucher();
        }
    });
</script>
}
