@model VaricoseSocks.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản y khoa - Varicose Socks";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4 text-center">
                <ol class="breadcrumb justify-content-center small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Đăng ký</li>
                </ol>
            </nav>

            <div class="glass-card bg-white p-4 p-md-5 border shadow-subtle position-relative overflow-hidden">
                @if (Model.Step == "otp")
                {
                    <!-- BƯỚC 2: XÁC THỰC MÃ OTP TỪ GMAIL -->
                    <div class="text-center mb-4">
                        <div class="bg-primary text-white rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 64px; height: 64px;">
                            <i class="bi bi-shield-lock-fill fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Xác Thực Mã OTP</h3>
                        <p class="text-muted small">Bước 2/2: Nhập mã xác nhận đã được gửi về Gmail để hoàn tất đăng ký</p>
                    </div>

                    @if (TempData["OtpSentMessage"] != null)
                    {
                        <div class="alert alert-info rounded-4 p-3 small mb-4 border-0 shadow-sm">
                            <i class="bi bi-info-circle-fill me-1 text-primary"></i>
                            @TempData["OtpSentMessage"]
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger rounded-3 p-3 small mb-3 border-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
                        </div>
                    }

                    <div class="p-3 bg-light rounded-4 border mb-4 text-center">
                        <div class="small text-muted mb-1">Mã xác thực đã được gửi đến hòm thư:</div>
                        <div class="fw-bold text-primary fs-6"><i class="bi bi-envelope-check-fill me-1"></i>@Model.Email</div>
                        <div class="small text-muted mt-2">
                            <i class="bi bi-shield-check text-success me-1"></i>Vui lòng mở ứng dụng Gmail hoặc tab Gmail của bạn để lấy mã OTP gồm 6 chữ số.
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="FullName" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Password" />
                        <input type="hidden" asp-for="ConfirmPassword" />
                        <input type="hidden" asp-for="Step" value="otp" />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-center d-block small text-dark mb-2">
                                NHẬP MÃ OTP 6 CHỮ SỐ:
                            </label>
                            <input asp-for="OtpCode" id="otpInput" class="form-control form-control-lg text-center fw-bold text-primary tracking-widest rounded-4 border-2" 
                                   style="font-size: 1.75rem; letter-spacing: 0.5rem; max-width: 260px; margin: 0 auto;"
                                   placeholder="------" maxlength="6" autofocus required />
                            <div class="text-center">
                                <span asp-validation-for="OtpCode" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm py-3 mb-3">
                            <i class="bi bi-check2-circle me-2"></i> Xác Thực OTP & Lưu Vào Database
                        </button>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top small">
                            <a asp-action="Register" class="text-muted text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i> Nhập lại thông tin
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="resendOtpAjax()">
                                <i class="bi bi-arrow-repeat me-1"></i> Gửi lại mã OTP
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <!-- BƯỚC 1: NHẬP THÔNG TIN TÀI KHOẢN RÚT GỌN -->
                    <div class="text-center mb-4">
                        <div class="bg-success text-white rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 58px; height: 58px;">
                            <i class="bi bi-person-plus-fill fs-3"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Tạo Tài Khoản Khách Hàng</h3>
                        <p class="text-muted small">Bước 1/2: Đăng ký nhanh với Gmail và nhận mã xác thực OTP bảo mật</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger rounded-3 p-3 small mb-3 border-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
                        </div>
                    }

                    <div class="alert alert-light border small text-muted rounded-4 p-3 mb-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
                            <div>
                                <strong>Đăng ký tinh gọn:</strong> Bạn không cần nhập số điện thoại và địa chỉ nhận hàng ngay bây giờ. Thông tin đó có thể bổ sung trong <strong>Hồ sơ cá nhân (Profile)</strong> hoặc khi <strong>Đặt hàng</strong>.
                            </div>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Step" value="form" />

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="FullName" class="form-label fw-semibold small">Họ và tên của bạn:</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                                    <input asp-for="FullName" class="form-control border-start-0" placeholder="Ví dụ: Chu Văn Quốc Trung" required />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold small">Địa chỉ Gmail nhận mã OTP:</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                    <input asp-for="Email" type="email" class="form-control border-start-0" placeholder="tenban@gmail.com" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold small">Mật khẩu:</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                    <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="Tối thiểu 6 ký tự..." required />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Xác nhận mật khẩu:</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0" placeholder="Nhập lại mật khẩu..." required />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-check my-3">
                            <input class="form-check-input" type="checkbox" id="termsCheck" checked required />
                            <label class="form-check-label small text-muted" for="termsCheck">
                                Tôi đồng ý với chính sách bảo mật thông tin y tế và quy chuẩn điều trị của Varicose Socks.
                            </label>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm py-3 mb-3">
                            <i class="bi bi-send-check-fill me-2"></i> Tiếp Tục & Nhận Mã OTP Gmail
                        </button>

                        <div class="text-center pt-3 border-top small text-muted">
                            Bạn đã có tài khoản? 
                            <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none">
                                Đăng nhập ngay
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function resendOtpAjax() {
            fetch('/Account/ResendOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert('Hệ thống đã gửi lại mã OTP mới vào hòm thư Gmail của bạn. Vui lòng kiểm tra email!');
                } else {
                    alert(data.message);
                }
            })
            .catch(err => alert('Không thể kết nối gửi lại OTP: ' + err));
        }
    </script>
}
