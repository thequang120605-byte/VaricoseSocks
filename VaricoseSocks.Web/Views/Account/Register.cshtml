@model VaricoseSocks.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản - Varicose Socks Y Khoa";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4 text-center">
                <ol class="breadcrumb justify-content-center small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Đăng ký</li>
                </ol>
            </nav>

            <div class="glass-card bg-white p-4 p-md-5 border shadow-subtle position-relative overflow-hidden">
                <div class="text-center mb-4">
                    <div class="bg-success text-white rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 58px; height: 58px;">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Tạo Tài Khoản Khách Hàng</h3>
                    <p class="text-muted small">Nhận tư vấn size vớ y khoa định kỳ và theo dõi hành trình đơn hàng</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger rounded-3 p-3 small mb-3 border-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label fw-semibold small">Họ và tên của bạn:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                                <input asp-for="FullName" class="form-control border-start-0" placeholder="Nguyễn Văn A" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">Địa chỉ Email:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control border-start-0" placeholder="email@gmail.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small">Số điện thoại:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                                <input asp-for="Phone" class="form-control border-start-0" placeholder="0901234567" required />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold small">Địa chỉ nhận hàng mặc định:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                                <input asp-for="Address" class="form-control border-start-0" placeholder="Số nhà, tên đường, phường xã, quận huyện" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold small">Mật khẩu:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                <input asp-for="Password" class="form-control border-start-0" placeholder="Tối thiểu 6 ký tự..." required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Xác nhận mật khẩu:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Nhập lại mật khẩu..." required />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check my-3">
                        <input class="form-check-input" type="checkbox" id="termsCheck" checked required />
                        <label class="form-check-label small text-muted" for="termsCheck">
                            Tôi đồng ý với điều khoản chăm sóc y tế và chính sách bảo mật của Varicose Socks.
                        </label>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm py-3 mb-3">
                        <i class="bi bi-check-circle-fill me-2"></i> Hoàn Tất Đăng Ký
                    </button>

                    <div class="text-center pt-3 border-top small text-muted">
                        Bạn đã có tài khoản? 
                        <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none">
                            Đăng nhập ngay
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
