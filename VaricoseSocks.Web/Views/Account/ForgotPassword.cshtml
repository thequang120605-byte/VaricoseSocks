@model VaricoseSocks.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu - Varicose Socks Y Khoa";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4 text-center">
                <ol class="breadcrumb justify-content-center small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Login" class="text-decoration-none">Đăng nhập</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Quên mật khẩu</li>
                </ol>
            </nav>

            <div class="glass-card bg-white p-4 p-md-5 border shadow-subtle position-relative overflow-hidden">
                @if (Model.Step == "otp")
                {
                    <!-- BƯỚC 2: XÁC THỰC MÃ OTP & ĐẶT MẬT KHẨU MỚI -->
                    <div class="text-center mb-4">
                        <div class="bg-primary text-white rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 58px; height: 58px;">
                            <i class="bi bi-shield-lock-fill fs-3"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Đặt Lại Mật Khẩu</h3>
                        <p class="text-muted small">Nhập mã OTP từ Gmail và thiết lập mật khẩu bảo mật mới</p>
                    </div>

                    @if (TempData["OtpSentMessage"] != null)
                    {
                        <div class="alert alert-info rounded-4 p-3 small mb-4 border-0 shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                            <div>@TempData["OtpSentMessage"]</div>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger rounded-3 p-3 small mb-3 border-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
                        </div>
                    }

                    <div class="p-3 bg-light rounded-4 border mb-4 text-center">
                        <div class="small text-muted mb-1">Mã xác thực OTP đã được gửi đến:</div>
                        <div class="fw-bold text-primary fs-6"><i class="bi bi-envelope-check-fill me-1"></i>@Model.Email</div>
                        <div class="small text-muted mt-2">
                            <i class="bi bi-clock-history text-warning me-1"></i>Mã OTP có hiệu lực trong 5 phút. Vui lòng kiểm tra Hộp thư đến hoặc Thư rác/Spam.
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Step" value="otp" />

                        <div class="mb-3 text-center">
                            <label class="form-label fw-bold small text-dark mb-2">
                                NHẬP MÃ OTP 6 CHỮ SỐ:
                            </label>
                            <input asp-for="OtpCode" id="forgotOtpInput" class="form-control form-control-lg text-center fw-bold text-primary tracking-widest rounded-4 border-2" 
                                   style="font-size: 1.75rem; letter-spacing: 0.5rem; max-width: 260px; margin: 0 auto;"
                                   placeholder="------" maxlength="6" autofocus required />
                            <span asp-validation-for="OtpCode" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold small">Mật khẩu mới:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                <input asp-for="NewPassword" id="newPasswordInput" type="password" class="form-control border-start-0 border-end-0" placeholder="Tối thiểu 6 ký tự..." required />
                                <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePasswordVisibility('newPasswordInput', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small">Xác nhận mật khẩu mới:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                                <input asp-for="ConfirmNewPassword" id="confirmNewPasswordInput" type="password" class="form-control border-start-0 border-end-0" placeholder="Nhập lại mật khẩu mới..." required />
                                <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePasswordVisibility('confirmNewPasswordInput', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-glow-primary py-3 mb-3">
                            <i class="bi bi-check2-circle me-2"></i> Xác Nhận & Đổi Mật Khẩu
                        </button>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top small">
                            <a asp-action="ForgotPassword" class="text-muted text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i> Nhập lại Email
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="resendForgotOtpAjax()">
                                <i class="bi bi-arrow-repeat me-1"></i> Gửi lại mã OTP
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <!-- BƯỚC 1: NHẬP EMAIL ĐÃ ĐĂNG KÝ -->
                    <div class="text-center mb-4">
                        <div class="bg-primary text-white rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 58px; height: 58px;">
                            <i class="bi bi-key-fill fs-3"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Khôi Phục Mật Khẩu</h3>
                        <p class="text-muted small">Nhập địa chỉ Email đã đăng ký để nhận mã OTP khôi phục tài khoản</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger rounded-3 p-3 small mb-3 border-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
                        </div>
                    }

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Step" value="email" />

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold small">Địa chỉ Email đã đăng ký:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" type="email" class="form-control border-start-0" placeholder="tenban@gmail.com" autofocus required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-glow-primary py-3 mb-3">
                            <i class="bi bi-send-check-fill me-2"></i> Gửi Mã Xác Thực OTP
                        </button>

                        <div class="text-center pt-3 border-top small text-muted">
                            Bạn đã nhớ lại mật khẩu? 
                            <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none">
                                Quay lại Đăng nhập
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }

    function resendForgotOtpAjax() {
        fetch('/Account/ResendForgotOtp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert('Hệ thống đã gửi lại mã OTP mới vào hòm thư Gmail của bạn. Vui lòng kiểm tra email!');
            } else {
                alert(data.message);
            }
        })
        .catch(err => alert('Không thể kết nối gửi lại OTP: ' + err));
    }
</script>
}
