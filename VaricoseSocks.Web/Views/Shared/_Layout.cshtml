<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Varicose Socks Y Khoa</title>
    
    <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom MedTech Design System & Motion CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Announcement Bar -->
    <div class="bg-dark text-white py-1 px-3 small text-center d-none d-md-block" style="background: linear-gradient(90deg, #0a192f 0%, #0f172a 100%); border-bottom: 1px solid rgba(255,255,255,0.08);">
        <span><i class="bi bi-truck me-1 text-warning"></i> Miễn phí giao hàng toàn quốc cho đơn từ 500.000₫</span>
        <span class="mx-3 opacity-50">|</span>
        <span><i class="bi bi-patch-check-fill me-1 text-info"></i> 100% Vớ y khoa chuẩn áp lực quốc tế RAL-GZ 387</span>
        <span class="mx-3 opacity-50">|</span>
        <span><i class="bi bi-telephone-fill me-1 text-success"></i> Hotline bác sĩ tư vấn: <strong>1900 6868</strong></span>
    </div>

    <!-- Smart Floating Glass Navigation Bar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark glass-nav py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold d-flex align-items-center text-nowrap" asp-controller="Home" asp-action="Index">
                    <div class="bg-white text-primary rounded-circle p-2 me-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px;">
                        <i class="bi bi-heart-pulse-fill fs-5" style="color: #0284c7;"></i>
                    </div>
                    <div>
                        <div class="lh-1 fs-5 fw-bold" style="letter-spacing: -0.03em;">VARICOSE SOCKS</div>
                        <small class="fw-medium text-white-50" style="font-size: 0.68rem; letter-spacing: 0.05em;">MEDTECH CLINICAL</small>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 text-nowrap">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1 text-info"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white fw-semibold px-3" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-grid me-1 text-info"></i> Danh mục vớ
                            </a>
                            <ul class="dropdown-menu shadow-lg border-0 rounded-4 p-2 mt-2" style="background: rgba(255,255,255,0.95); backdrop-filter: blur(16px);">
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Product" asp-action="Index"><i class="bi bi-collection me-2 text-primary"></i>Tất cả sản phẩm</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Product" asp-action="Index" asp-route-categoryId="1"><i class="bi bi-check2-circle me-2 text-info"></i>Vớ gối y khoa (AD)</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Product" asp-action="Index" asp-route-categoryId="2"><i class="bi bi-check2-circle me-2 text-info"></i>Vớ đùi y khoa (AG)</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Product" asp-action="Index" asp-route-categoryId="3"><i class="bi bi-check2-circle me-2 text-info"></i>Quần vớ y khoa (AT)</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Product" asp-action="Index" asp-route-categoryId="4"><i class="bi bi-heart me-2 text-danger"></i>Quần vớ cho bà bầu</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" asp-controller="Product" asp-action="Index" asp-route-categoryId="5"><i class="bi bi-tools me-2 text-secondary"></i>Phụ kiện & Khung xỏ vớ</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold px-3" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-bag-check me-1 text-info"></i> Sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold px-3" asp-controller="Order" asp-action="Track">
                                <i class="bi bi-truck me-1 text-info"></i> Tra cứu đơn hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold px-3" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Quản trị Admin
                            </a>
                        </li>
                    </ul>

                    <!-- Spotlight Search Quick Trigger -->
                    <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1 me-lg-3 my-2 my-lg-0 text-white-50 d-flex align-items-center gap-2 border-secondary" onclick="toggleSpotlightSearch()" style="background: rgba(255,255,255,0.08);">
                        <i class="bi bi-search text-info"></i>
                        <span>Tìm vớ, cấp độ nén...</span>
                        <kbd class="bg-dark text-white-50 py-0 px-1 rounded small border border-secondary" style="font-size: 0.65rem;">Ctrl K</kbd>
                    </button>

                    <!-- Cart and Consultation Actions -->
                    <div class="d-flex align-items-center gap-2 text-nowrap">
                        <button type="button" class="btn btn-light btn-sm fw-bold rounded-pill px-3 py-2 text-primary shadow-sm" onclick="openChatbot()">
                            <i class="bi bi-robot text-primary me-1"></i> AI Tư Vấn
                        </button>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-warning rounded-pill px-3 py-2 position-relative fw-bold text-dark shadow-sm">
                            <i class="bi bi-cart3 me-1"></i> Giỏ hàng
                            <span id="cartCountBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white">
                                0
                            </span>
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <div class="rounded-circle bg-warning text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.75rem;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="text-truncate" style="max-width: 120px;">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2" style="background: rgba(255,255,255,0.96); backdrop-filter: blur(16px);">
                                    <li><h6 class="dropdown-header small">Tài khoản: @User.Identity.Name</h6></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-2 text-primary"></i>Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-receipt me-2 text-info"></i>Lịch sử đơn hàng</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item rounded-3 py-2 text-warning" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Quản trị Admin</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item rounded-3 py-2 text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 fw-semibold">
                                <i class="bi bi-person me-1"></i> Đăng nhập
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-semibold shadow-sm d-none d-sm-inline-block">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-top py-5 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-heart-pulse-fill fs-5"></i>
                        </div>
                        <h5 class="fw-bold text-primary mb-0">VARICOSE SOCKS</h5>
                    </div>
                    <p class="text-muted small">
                        Hệ thống phân phối vớ y khoa điều trị suy giãn tĩnh mạch chính hãng từ Đức, Mỹ, Ý. Đạt chuẩn áp lực y khoa giảm dần RAL-GZ 387, chứng chỉ CE, FDA và khuyến cáo từ Hội Mạch Máu Việt Nam.
                    </p>
                    <div class="d-flex gap-3 text-primary fs-5">
                        <i class="bi bi-facebook cursor-pointer"></i>
                        <i class="bi bi-youtube cursor-pointer text-danger"></i>
                        <i class="bi bi-shield-fill-check text-success cursor-pointer"></i>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3 text-dark">Về Sản Phẩm</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a class="text-decoration-none text-muted" asp-controller="Product" asp-action="Index" asp-route-compression="1">Vớ áp lực CCL1 (15-20)</a></li>
                        <li class="mb-2"><a class="text-decoration-none text-muted" asp-controller="Product" asp-action="Index" asp-route-compression="2">Vớ áp lực CCL2 (20-30)</a></li>
                        <li class="mb-2"><a class="text-decoration-none text-muted" asp-controller="Product" asp-action="Index" asp-route-compression="3">Vớ áp lực CCL3 (30-40)</a></li>
                        <li class="mb-2"><a class="text-decoration-none text-muted" asp-controller="Product" asp-action="Index" asp-route-categoryId="4">Quần vớ cho bà bầu</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-dark">Hỗ Trợ Khách Hàng</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a class="text-decoration-none text-muted" href="javascript:void(0)" onclick="openSizeModal()">Hướng dẫn đo size chân cB/cC</a></li>
                        <li class="mb-2"><a class="text-decoration-none text-muted" asp-controller="Order" asp-action="Track">Tra cứu hành trình đơn hàng</a></li>
                        <li class="mb-2"><a class="text-decoration-none text-muted" href="javascript:void(0)" onclick="openChatbot()">Trợ lý AI tư vấn tĩnh mạch</a></li>
                        <li class="mb-2"><a class="text-decoration-none text-muted" asp-controller="Admin" asp-action="Index">Hệ thống quản trị Admin</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-dark">Liên Hệ Y Tế</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-geo-alt-fill text-danger me-2"></i>123 Hai Bà Trưng, Quận 1, TP. Hồ Chí Minh</p>
                    <p class="small text-muted mb-1"><i class="bi bi-telephone-fill text-success me-2"></i>Hotline: 1900 6868 - 0987.654.321</p>
                    <p class="small text-muted mb-1"><i class="bi bi-envelope-fill text-primary me-2"></i>tuvan@varicosesocks.vn</p>
                    <div class="mt-3">
                        <span class="badge bg-success-subtle text-success border border-success p-2 rounded-pill">
                            <i class="bi bi-patch-check me-1"></i> Bác sĩ chuyên khoa trực tuyến 24/7
                        </span>
                    </div>
                </div>
            </div>

            <hr class="my-4" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
                <div>&copy; 2026 Varicose Socks - Nền Tảng Vớ Y Khoa Chuyên Nghiệp. Chu Văn Quốc Trung & Nguyễn Thế Quang.</div>
                <div class="mt-2 mt-md-0 d-flex gap-3">
                    <span><i class="bi bi-shield-check text-success me-1"></i>RAL-GZ 387</span>
                    <span><i class="bi bi-phone text-primary me-1"></i>Responsive Mobile</span>
                    <span><i class="bi bi-lightning text-warning me-1"></i>Ultra-Fast Engine</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Spotlight Search Modal (Ctrl + K) -->
    <div class="modal fade" id="spotlightSearchModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px);">
                <div class="modal-header border-bottom p-3">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 fs-5 text-primary"><i class="bi bi-search"></i></span>
                        <input type="text" id="spotlightInput" class="form-control border-0 fs-5 shadow-none" placeholder="Tìm sản phẩm, mức nén CCL1, CCL2, thương hiệu Jobst, Mediven..." onkeyup="if(event.key==='Enter') window.location.href='/Product?searchTerm='+this.value;" />
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-muted small fw-bold mb-3">LỐI TẮT NHANH ĐỀ XUẤT:</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <a href="/Product?compression=1" class="d-flex align-items-center p-3 rounded-3 border bg-white text-decoration-none text-dark shadow-sm">
                                <span class="badge bg-primary me-3">CCL1</span>
                                <div>
                                    <div class="fw-bold">Vớ áp lực nhẹ (15-20 mmHg)</div>
                                    <small class="text-muted">Mỏi chân, gân mạng nhện, văn phòng</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="/Product?compression=2" class="d-flex align-items-center p-3 rounded-3 border bg-white text-decoration-none text-dark shadow-sm">
                                <span class="badge bg-purple text-white me-3" style="background:#7c3aed;">CCL2</span>
                                <div>
                                    <div class="fw-bold">Vớ điều trị y khoa (20-30 mmHg)</div>
                                    <small class="text-muted">Gân xanh nổi to, phù mắt cá chân</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="/Product?categoryId=4" class="d-flex align-items-center p-3 rounded-3 border bg-white text-decoration-none text-dark shadow-sm">
                                <span class="badge bg-danger me-3">BÀ BẦU</span>
                                <div>
                                    <div class="fw-bold">Quần vớ y khoa cho mẹ bầu</div>
                                    <small class="text-muted">Đai nâng bụng, chống phù nề thai kỳ</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="javascript:void(0)" onclick="openSizeModal(); bootstrap.Modal.getInstance(document.getElementById('spotlightSearchModal')).hide();" class="d-flex align-items-center p-3 rounded-3 border bg-white text-decoration-none text-dark shadow-sm">
                                <span class="badge bg-success me-3">ĐO SIZE</span>
                                <div>
                                    <div class="fw-bold">Thước đo size tự động</div>
                                    <small class="text-muted">Nhập số đo vòng cổ chân (cB)</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating AI Doctor Aura FAB Button -->
    <div class="ai-fab-aura">
        <div class="ai-fab-ring"></div>
        <button id="chatbotToggleBtn" class="ai-fab-btn" onclick="toggleChatbot()" title="Bác sĩ AI Tư Vấn Vớ Y Khoa">
            <i class="bi bi-robot fs-3"></i>
        </button>
    </div>

    <!-- Chatbot Window Card -->
    <div id="chatbotWindow" class="card position-fixed bottom-0 end-0 m-3 shadow-lg border-0 d-none" style="width: 380px; max-width: 92vw; height: 540px; z-index: 1060;">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;">
            <div class="d-flex align-items-center">
                <i class="bi bi-robot fs-4 me-2 text-warning"></i>
                <div>
                    <strong class="d-block lh-1">Bác sĩ AI Tư Vấn Vớ Y Khoa</strong>
                    <small class="text-white-50" style="font-size: 0.75rem;">Chẩn đoán triệu chứng & đo size chân</small>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" onclick="toggleChatbot()"></button>
        </div>

        <!-- Chat Messages Log -->
        <div class="card-body overflow-y-auto p-3" id="chatbotMessages" style="height: 380px; background-color: #f8fafc;">
            <div class="d-flex mb-3">
                <div class="bg-white p-3 rounded-4 shadow-sm border small text-dark" style="max-width: 85%; border-bottom-left-radius: 4px;">
                    <div class="fw-bold text-primary mb-1"><i class="bi bi-shield-plus me-1"></i> Bác sĩ AI Varicose</div>
                    Xin chào bạn! Tôi là trợ lý AI chuyên về vớ y khoa suy giãn tĩnh mạch. Bạn có thể cho tôi biết:
                    <ul class="mb-1 ps-3 mt-1">
                        <li>Bạn có triệu chứng mỏi chân, nặng chân hay nổi gân xanh không?</li>
                        <li>Bạn đang mang thai hay đứng nhiều không?</li>
                        <li>Hoặc kéo thước đo size cổ chân để tôi tính size chuẩn xác nhé!</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Quick Action Pills -->
        <div class="px-2 py-1 bg-white border-top d-flex gap-1 overflow-x-auto text-nowrap" style="scrollbar-width: none;">
            <button class="btn btn-outline-primary btn-sm py-1 px-2 rounded-pill" style="font-size: 0.75rem;" onclick="sendQuickMsg('Tôi hay bị mỏi phù chân vào buổi chiều')">Mỏi phù chân</button>
            <button class="btn btn-outline-primary btn-sm py-1 px-2 rounded-pill" style="font-size: 0.75rem;" onclick="sendQuickMsg('Tôi bị nổi gân xanh ngoằn ngoèo ở bắp chân')">Nổi gân xanh</button>
            <button class="btn btn-outline-primary btn-sm py-1 px-2 rounded-pill" style="font-size: 0.75rem;" onclick="sendQuickMsg('Tôi đang mang thai muốn tìm vớ cho bà bầu')">Mẹ bầu</button>
            <button class="btn btn-outline-success btn-sm py-1 px-2 rounded-pill" style="font-size: 0.75rem;" onclick="promptSizeTool()">Tính Size</button>
        </div>

        <!-- Chat Input Form -->
        <div class="card-footer bg-white border-top p-2">
            <form id="chatbotForm" onsubmit="handleChatSubmit(event)" class="d-flex gap-2">
                <input type="text" id="chatInput" class="form-control form-control-sm rounded-pill" placeholder="Nhập triệu chứng hoặc số đo..." autocomplete="off" />
                <button type="submit" class="btn btn-primary btn-sm px-3 rounded-circle">
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Size Guide Modal -->
    <div class="modal fade" id="sizeGuideModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
                    <h5 class="modal-title"><i class="bi bi-rulers me-2"></i>Bảng Hướng Dẫn Đo Size Vớ Y Khoa Chuẩn RAL-GZ 387</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row align-items-center mb-4 g-4">
                        <div class="col-md-6">
                            <h6 class="fw-bold text-primary">Các vị trí đo chuẩn xác (đo vào buổi sáng):</h6>
                            <ul class="small text-muted">
                                <li><strong class="text-dark">cB (Vòng cổ chân):</strong> Đo vòng nhỏ nhất phía trên mắt cá chân. (Quan trọng nhất quyết định size).</li>
                                <li><strong class="text-dark">cC (Vòng bắp chân):</strong> Đo vị trí nở to nhất của bắp chân.</li>
                                <li><strong class="text-dark">cG (Vòng đùi):</strong> Đo dưới nếp lằn mông 5cm (áp dụng cho vớ đùi & quần vớ).</li>
                            </ul>
                        </div>
                        <div class="col-md-6 bg-light p-3 rounded-4 border">
                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-calculator me-1"></i> Tính size tự động ngay:</h6>
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text bg-white">Vòng cổ chân cB:</span>
                                <input type="number" step="0.1" id="modalAnkleInput" class="form-control" placeholder="Vd: 22.5" />
                                <span class="input-group-text bg-white">cm</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary w-100 rounded-pill fw-bold" onclick="calculateModalSize()">Xem Size Của Bạn</button>
                            <div id="modalSizeResult" class="mt-2 text-center small fw-bold text-danger"></div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped text-center align-middle small">
                            <thead class="table-primary">
                                <tr>
                                    <th>Kích thước (Size)</th>
                                    <th>Chu vi cổ chân cB (cm)</th>
                                    <th>Chu vi bắp chân cC (cm)</th>
                                    <th>Chu vi đùi cG (cm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td><strong class="text-primary">Size S</strong></td><td>18 - 21</td><td>28 - 38</td><td>40 - 62</td></tr>
                                <tr><td><strong class="text-primary">Size M</strong></td><td>21 - 25</td><td>30 - 42</td><td>46 - 70</td></tr>
                                <tr><td><strong class="text-primary">Size L</strong></td><td>25 - 29</td><td>32 - 46</td><td>54 - 78</td></tr>
                                <tr><td><strong class="text-primary">Size XL</strong></td><td>29 - 33</td><td>34 - 50</td><td>60 - 81</td></tr>
                                <tr><td><strong class="text-primary">Size XXL</strong></td><td>> 33</td><td>> 50</td><td>> 81</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Stacked Toast Container for Micro-Interactions -->
    <div id="toastContainer"></div>

    <!-- Scripts: Bootstrap 5, GSAP, Canvas Confetti & site.js -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
