@model VaricoseSocks.Web.Models.OrderTrackingViewModel
@{
    ViewData["Title"] = "Tra cứu đơn hàng - Varicose Socks";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary mb-2">
            <i class="bi bi-truck me-2"></i>Tra Cứu Hành Trình Đơn Hàng
        </h2>
        <p class="text-muted">Nhập mã đơn hàng của bạn (Ví dụ: <strong>VS-20261019-8921</strong>) để kiểm tra trạng thái đóng gói và giao hàng.</p>

        <!-- Search Form -->
        <div class="row justify-content-center mt-3">
            <div class="col-md-7 col-lg-5">
                <form asp-controller="Order" asp-action="Track" method="get" class="d-flex gap-2">
                    <input type="text" name="query" value="@Model.SearchQuery" class="form-control form-control-lg" placeholder="Nhập mã đơn hàng..." required />
                    <button type="submit" class="btn btn-warning btn-lg fw-bold px-4 text-dark text-nowrap">
                        <i class="bi bi-search me-1"></i> Tra cứu
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (Model.HasSearched)
    {
        if (Model.Order != null)
        {
            var o = Model.Order;
            var currentStep = o.OrderStatus; // 1 to 5

            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mx-auto" style="max-width: 850px;">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Mã đơn: @o.OrderCode</h4>
                        <small class="text-muted">Ngày đặt: @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div>
                        <span class="badge bg-primary fs-6 px-3 py-2">Trạng thái: @o.OrderStatusText</span>
                    </div>
                </div>

                <!-- Timeline Progress Bar -->
                <div class="row text-center mb-5 position-relative">
                    <div class="col">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2 @(currentStep >= 1 ? "bg-primary text-white" : "bg-light text-muted border")" style="width: 50px; height: 50px;">
                            <i class="bi bi-receipt"></i>
                        </div>
                        <div class="small fw-bold @(currentStep >= 1 ? "text-primary" : "text-muted")">Chờ xác nhận</div>
                    </div>

                    <div class="col">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2 @(currentStep >= 2 ? "bg-primary text-white" : "bg-light text-muted border")" style="width: 50px; height: 50px;">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <div class="small fw-bold @(currentStep >= 2 ? "text-primary" : "text-muted")">Đã xác nhận</div>
                    </div>

                    <div class="col">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2 @(currentStep >= 3 ? "bg-primary text-white" : "bg-light text-muted border")" style="width: 50px; height: 50px;">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="small fw-bold @(currentStep >= 3 ? "text-primary" : "text-muted")">Đang đóng gói</div>
                    </div>

                    <div class="col">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2 @(currentStep >= 4 ? "bg-primary text-white" : "bg-light text-muted border")" style="width: 50px; height: 50px;">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div class="small fw-bold @(currentStep >= 4 ? "text-primary" : "text-muted")">Đang giao hàng</div>
                    </div>

                    <div class="col">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2 @(currentStep >= 5 ? "bg-success text-white" : "bg-light text-muted border")" style="width: 50px; height: 50px;">
                            <i class="bi bi-house-check"></i>
                        </div>
                        <div class="small fw-bold @(currentStep >= 5 ? "text-success" : "text-muted")">Hoàn thành</div>
                    </div>
                </div>

                <!-- Customer Details -->
                <div class="bg-light p-3 rounded-3 mb-4 border">
                    <div class="row g-2 small">
                        <div class="col-md-6"><strong>Người nhận:</strong> @o.CustomerName - @o.CustomerPhone</div>
                        <div class="col-md-6"><strong>Địa chỉ:</strong> @o.ShippingAddress, @(o.District ?? ""), @(o.City ?? "")</div>
                        <div class="col-md-6"><strong>Hình thức:</strong> @o.PaymentMethodText (@o.PaymentStatusText)</div>
                        <div class="col-md-6"><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(o.Note) ? "Không có" : o.Note)</div>
                    </div>
                </div>

                <!-- Items list -->
                <h6 class="fw-bold text-dark mb-2">Chi tiết sản phẩm:</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Size / Màu</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in o.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "https://placehold.co/80x80?text=Vớ" : item.ProductImageUrl)" 
                                                 class="rounded border me-2" style="width: 40px; height: 40px; object-fit: contain;" />
                                            <span>@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td>@item.Size - @item.Color</td>
                                    <td>@item.UnitPrice.ToString("N0") ₫</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-danger fw-bold">@item.TotalPrice.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Tổng thanh toán:</td>
                                <td class="text-danger fw-bold fs-6">@o.TotalAmount.ToString("N0") ₫</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-danger mx-auto text-center p-4 rounded-4" style="max-width: 600px;">
                <i class="bi bi-exclamation-triangle-fill fs-2 mb-2 d-block"></i>
                <h5 class="fw-bold">@Model.ErrorMessage</h5>
                <p class="small mb-0">Vui lòng kiểm tra lại mã đơn hàng trên email hoặc liên hệ hotline 1900 6868 để được hỗ trợ.</p>
            </div>
        }
    }
</div>
