@model VaricoseSocks.Web.Models.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng vớ y khoa của bạn";
    var freeShipThreshold = 500000m;
    var progressPercent = Model.SubTotal >= freeShipThreshold ? 100 : Math.Min(100, (int)((Model.SubTotal / freeShipThreshold) * 100));
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="bi bi-cart3 me-2"></i>Giỏ Hàng Của Bạn (@Model.TotalQuantity sản phẩm)
        </h3>
        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="openSizeModal()">
            <i class="bi bi-rulers me-1"></i> Kiểm tra size chân
        </button>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="glass-card p-5 text-center bg-white my-4 border shadow-subtle">
            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-cart-x fs-1 text-muted"></i>
            </div>
            <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-muted">Hãy lựa chọn các dòng vớ y khoa chuẩn áp lực để bảo vệ và phục hồi đôi chân ngay hôm nay.</p>
            <div class="mt-4">
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-3 rounded-pill fw-bold shadow-sm">
                    <i class="bi bi-bag-plus me-2"></i> Khám phá sản phẩm ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Free Shipping Dynamic Indicator -->
        <div class="glass-card p-4 mb-4 bg-white border shadow-subtle position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-center mb-2 small fw-bold">
                @if (Model.SubTotal >= freeShipThreshold)
                {
                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Chúc mừng! Đơn hàng của bạn đã được MIỄN PHÍ VẬN CHUYỂN toàn quốc!</span>
                }
                else
                {
                    <span class="text-primary"><i class="bi bi-truck me-1"></i> Mua thêm <strong class="text-danger">@((freeShipThreshold - Model.SubTotal).ToString("N0")) ₫</strong> để nhận MIỄN PHÍ VẬN CHUYỂN</span>
                }
                <span class="badge bg-primary rounded-pill px-3 py-1">@progressPercent%</span>
            </div>
            <div class="progress rounded-pill" style="height: 10px; background-color: #f1f5f9;">
                <div class="progress-bar progress-bar-striped progress-bar-animated @(progressPercent >= 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @progressPercent%"></div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Items Table -->
            <div class="col-lg-8">
                <div class="glass-card bg-white p-4 border shadow-subtle">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light rounded-3">
                                <tr>
                                    <th class="border-0">Sản phẩm</th>
                                    <th class="border-0">Phân loại</th>
                                    <th class="border-0">Đơn giá</th>
                                    <th class="border-0" style="width: 140px;">Số lượng</th>
                                    <th class="border-0">Thành tiền</th>
                                    <th class="border-0"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "https://placehold.co/100x100?text=Vớ" : item.ProductImageUrl)" 
                                                     class="rounded-3 me-3 border p-1 bg-light" style="width: 60px; height: 60px; object-fit: contain;" alt="@item.ProductName" />
                                                <div>
                                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none hover-primary">
                                                        @item.ProductName
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Size: @item.Size</span><br />
                                            <small class="text-muted">@item.Color</small>
                                        </td>
                                        <td class="text-nowrap fw-semibold">
                                            @item.UnitPrice.ToString("N0") ₫
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm rounded-pill overflow-hidden border">
                                                <button class="btn btn-light border-0 px-2" type="button" onclick="updateCartQty(@item.Id, @(item.Quantity - 1))">-</button>
                                                <input type="number" class="form-control text-center border-0 fw-bold bg-white" value="@item.Quantity" min="1" 
                                                       onchange="updateCartQty(@item.Id, parseInt(this.value) || 1)" />
                                                <button class="btn btn-light border-0 px-2" type="button" onclick="updateCartQty(@item.Id, @(item.Quantity + 1))">+</button>
                                            </div>
                                        </td>
                                        <td class="text-nowrap text-danger fw-bold">
                                            @item.TotalPrice.ToString("N0") ₫
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle border-0" onclick="removeCartItem(@item.Id)" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn vớ
                        </a>
                        <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i> Đổi size miễn phí trong 7 ngày</span>
                    </div>
                </div>
            </div>

            <!-- Summary Order Box -->
            <div class="col-lg-4">
                <div class="glass-card bg-white p-4 sticky-top border shadow-subtle" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3">Tóm tắt đơn hàng</h5>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-bold">@Model.SubTotal.ToString("N0") ₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Phí vận chuyển:</span>
                        @if (Model.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold">Miễn phí toàn quốc</span>
                        }
                        else
                        {
                            <span class="fw-bold">@Model.ShippingFee.ToString("N0") ₫</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Bảo hành y tế:</span>
                        <span class="text-success fw-bold">Đổi size 7 ngày</span>
                    </div>

                    <!-- Voucher Box -->
                    <div class="input-group input-group-sm mb-3">
                        <input type="text" class="form-control rounded-start-pill" placeholder="Mã giảm giá (VARICOSE10)" value="VARICOSE10" />
                        <button class="btn btn-primary rounded-end-pill px-3 fw-bold" type="button" onclick="triggerConfetti(); showModernToast('Áp dụng ưu đãi thành công!', 'Giảm 10% cho đơn hàng vớ y khoa.', 'success');">Áp dụng</button>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold text-dark">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-warning btn-lg w-100 fw-bold text-dark rounded-pill shadow-glow-warning py-3">
                        <i class="bi bi-credit-card me-2"></i> Tiến Hành Đặt Hàng
                    </a>

                    <div class="mt-3 text-center small text-muted">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Thanh toán an toàn & bảo mật 100%
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (@progressPercent >= 100) {
            triggerConfetti();
        }
    });
</script>
}
