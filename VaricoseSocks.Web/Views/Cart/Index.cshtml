@model VaricoseSocks.Web.Models.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng vớ y khoa của bạn";
    var freeShipThreshold = 500000m;
    var progressPercent = Model.SubTotal >= freeShipThreshold ? 100 : Math.Min(100, (int)((Model.SubTotal / freeShipThreshold) * 100));
    var hasStockOverflow = Model.Items.Any(i => i.StockQuantity > 0 && i.Quantity > i.StockQuantity);
    var hasOutOfStock = Model.Items.Any(i => i.StockQuantity <= 0);
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
        </ol>
    </nav>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4 border-0">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <strong>Thông báo giỏ hàng:</strong> @TempData["ErrorMessage"]
        </div>
    }

    @if (hasStockOverflow || hasOutOfStock)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4 border-0">
            <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
            <strong>Cảnh báo tồn kho:</strong> Có sản phẩm trong giỏ hàng vượt quá số lượng khả dụng trong kho hoặc đã hết hàng. Quý khách vui lòng điều chỉnh lại số lượng để tiếp tục tiến hành đặt hàng.
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="bi bi-cart3 me-2"></i>Giỏ Hàng Của Bạn (@Model.TotalQuantity sản phẩm)
        </h3>
        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="openSizeModal()">
            <i class="bi bi-rulers me-1"></i> Kiểm tra size chân
        </button>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="glass-card p-5 text-center bg-white my-4 border shadow-subtle">
            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-cart-x fs-1 text-muted"></i>
            </div>
            <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-muted">Hãy lựa chọn các dòng vớ y khoa chuẩn áp lực để bảo vệ và phục hồi đôi chân ngay hôm nay.</p>
            <div class="mt-4">
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-3 rounded-pill fw-bold shadow-sm">
                    <i class="bi bi-bag-plus me-2"></i> Khám phá sản phẩm ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Free Shipping Dynamic Indicator -->
        <div class="glass-card p-4 mb-4 bg-white border shadow-subtle position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-center mb-2 small fw-bold">
                @if (Model.SubTotal >= freeShipThreshold)
                {
                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Chúc mừng! Đơn hàng của bạn đã được MIỄN PHÍ VẬN CHUYỂN toàn quốc!</span>
                }
                else
                {
                    <span class="text-primary"><i class="bi bi-truck me-1"></i> Mua thêm <strong class="text-danger">@((freeShipThreshold - Model.SubTotal).ToString("N0")) ₫</strong> để nhận MIỄN PHÍ VẬN CHUYỂN</span>
                }
                <span class="badge bg-primary rounded-pill px-3 py-1">@progressPercent%</span>
            </div>
            <div class="progress rounded-pill" style="height: 10px; background-color: #f1f5f9;">
                <div class="progress-bar progress-bar-striped progress-bar-animated @(progressPercent >= 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @progressPercent%"></div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Items Table -->
            <div class="col-lg-8">
                <div class="glass-card bg-white p-4 border shadow-subtle">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light rounded-3">
                                <tr>
                                    <th class="border-0">Sản phẩm</th>
                                    <th class="border-0">Phân loại</th>
                                    <th class="border-0">Đơn giá</th>
                                    <th class="border-0" style="width: 140px;">Số lượng</th>
                                    <th class="border-0">Thành tiền</th>
                                    <th class="border-0"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "/images/products/vo-goi-jobst-ccl2.svg" : item.ProductImageUrl)" 
                                                     class="rounded-3 me-3 border p-1 bg-light" style="width: 60px; height: 60px; object-fit: contain;" alt="@item.ProductName" />
                                                <div>
                                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none hover-primary">
                                                        @item.ProductName
                                                    </a>
                                                    <div class="mt-1">
                                                        @if (item.StockQuantity > 0)
                                                        {
                                                            <span class="badge bg-light text-secondary border small">
                                                                <i class="bi bi-box-seam me-1 text-primary"></i>Kho còn: <strong class="text-dark">@item.StockQuantity</strong> sản phẩm
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                                                                <i class="bi bi-x-circle me-1"></i>Hết hàng
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Size: @item.Size</span><br />
                                            <small class="text-muted">@item.Color</small>
                                        </td>
                                        <td class="text-nowrap fw-semibold">
                                            @item.UnitPrice.ToString("N0") ₫
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm rounded-pill overflow-hidden border" style="width: 120px;">
                                                <button class="btn btn-light border-0 px-2" type="button" onclick="updateCartQty(@item.Id, @(item.Quantity - 1), @item.StockQuantity)">-</button>
                                                <input type="number" class="form-control text-center border-0 fw-bold bg-white" value="@item.Quantity" min="1" max="@item.StockQuantity" 
                                                       data-stock="@item.StockQuantity"
                                                       onchange="onCartInputQtyChange(this, @item.Id, @item.StockQuantity)" />
                                                <button class="btn btn-light border-0 px-2 @(item.StockQuantity > 0 && item.Quantity >= item.StockQuantity ? "disabled opacity-50" : "")" 
                                                        type="button" onclick="updateCartQty(@item.Id, @(item.Quantity + 1), @item.StockQuantity)">+</button>
                                            </div>
                                            @if (item.StockQuantity > 0 && item.Quantity > item.StockQuantity)
                                            {
                                                <div class="text-danger small mt-1 fw-bold" style="font-size: 0.72rem;">
                                                    <i class="bi bi-exclamation-triangle-fill"></i> Vượt kho (@item.StockQuantity)!
                                                </div>
                                            }
                                            else if (item.StockQuantity <= 0)
                                            {
                                                <div class="text-danger small mt-1 fw-bold" style="font-size: 0.72rem;">
                                                    <i class="bi bi-x-circle-fill"></i> Hết hàng!
                                                </div>
                                            }
                                        </td>
                                        <td class="text-nowrap text-danger fw-bold">
                                            @item.TotalPrice.ToString("N0") ₫
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle border-0" onclick="removeCartItem(@item.Id)" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn vớ
                        </a>
                        <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i> Đổi size miễn phí trong 7 ngày</span>
                    </div>
                </div>
            </div>

            <!-- Summary Order Box -->
            <div class="col-lg-4">
                <div class="glass-card bg-white p-4 sticky-top border shadow-subtle" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3">Tóm tắt đơn hàng</h5>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-bold">@Model.SubTotal.ToString("N0") ₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Phí vận chuyển:</span>
                        @if (Model.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold">Miễn phí toàn quốc</span>
                        }
                        else
                        {
                            <span class="fw-bold">@Model.ShippingFee.ToString("N0") ₫</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Bảo hành y tế:</span>
                        <span class="text-success fw-bold">Đổi size 7 ngày</span>
                    </div>

                    <!-- Available Vouchers Notice -->
                    <div class="p-3 bg-light rounded-4 border mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-ticket-perforated-fill text-primary"></i>
                            <span class="fw-bold small text-dark">Mã ưu đãi hiện có:</span>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                                <i class="bi bi-tag-fill me-1"></i>VARICOSE10 (Giảm 10%)
                            </span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                <i class="bi bi-truck me-1"></i>FREESHIP (Đơn từ 500k)
                            </span>
                        </div>
                        <div class="text-muted small mt-2" style="font-size: 0.74rem;">
                            <i class="bi bi-info-circle me-1"></i>Mã giảm giá sẽ được áp dụng và tính chiết khấu tại bước <strong>Thanh Toán</strong>.
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold text-dark">Tạm tính thanh toán:</span>
                        <span class="fs-4 fw-bold text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                    </div>

                    @if (hasStockOverflow || hasOutOfStock)
                    {
                        <button type="button" class="btn btn-secondary btn-lg w-100 fw-bold rounded-pill py-3 opacity-75" disabled>
                            <i class="bi bi-exclamation-octagon me-2"></i> Vượt Quá Tồn Kho Khả Dụng
                        </button>
                        <div class="mt-2 text-center text-danger small">
                            <i class="bi bi-info-circle me-1"></i>Vui lòng điều chỉnh số lượng sản phẩm bằng hoặc nhỏ hơn tồn kho để thanh toán.
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-warning btn-lg w-100 fw-bold text-dark rounded-pill shadow-glow-warning py-3">
                            <i class="bi bi-credit-card me-2"></i> Tiến Hành Đặt Hàng
                        </a>
                    }

                    @if (!(User.Identity?.IsAuthenticated == true))
                    {
                        <div class="mt-2 text-center text-muted small" style="font-size: 0.78rem;">
                            <i class="bi bi-person-lock me-1 text-primary"></i>Bạn sẽ được yêu cầu đăng nhập tài khoản trước khi thanh toán.
                        </div>
                    }

                    <div class="mt-3 text-center small text-muted">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Thanh toán an toàn & bảo mật 100%
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function onCartInputQtyChange(input, cartItemId, maxStock) {
        let val = parseInt(input.value) || 1;
        if (val < 1) val = 1;
        if (maxStock > 0 && val > maxStock) {
            val = maxStock;
            if (typeof showModernToast === 'function') {
                showModernToast('Vượt quá tồn kho!', `Kho chỉ còn tối đa ${maxStock} sản phẩm.`, 'warning');
            } else {
                alert(`Kho chỉ còn tối đa ${maxStock} sản phẩm.`);
            }
        }
        input.value = val;
        updateCartQty(cartItemId, val, maxStock);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const totalQty = @Model.TotalQuantity;
        const b = document.getElementById('cartCountBadge');
        if (b) b.innerText = totalQty;
        const bm = document.getElementById('cartCountBadgeMobile');
        if (bm) bm.innerText = totalQty;

        if (@progressPercent >= 100) {
            triggerConfetti();
        }

        // Gọi trực tiếp RESTful API Cart (port 5046) để hiển thị rõ ràng trên DevTools Network Fetch/XHR
        try {
            const sid = typeof getOrCreateClientSessionId === 'function' ? getOrCreateClientSessionId() : '';
            console.log('[DevTools Network Fetch/XHR] 🚀 Gửi HTTP GET: http://localhost:5046/api/cart?sessionId=' + sid);
            fetch('http://localhost:5046/api/cart?sessionId=' + encodeURIComponent(sid))
                .then(r => r.json())
                .then(d => console.log('[DevTools Network Fetch/XHR] ✅ Dữ liệu giỏ hàng từ API 5046:', d))
                .catch(e => console.log('Cart fetch error:', e));
        } catch {}
    });
</script>
}
