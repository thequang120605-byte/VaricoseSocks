@model VaricoseSocks.Web.Models.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    var freeShipThreshold = 500000m;
    var progressPercent = Model.SubTotal >= freeShipThreshold ? 100 : Math.Min(100, (int)((Model.SubTotal / freeShipThreshold) * 100));
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
        </ol>
    </nav>

    <h3 class="fw-bold text-primary mb-3">
        <i class="bi bi-cart3 me-2"></i>Giỏ Hàng Của Bạn (@Model.TotalQuantity sản phẩm)
    </h3>

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <i class="bi bi-cart-x fs-1 text-muted mb-3"></i>
            <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-muted">Hãy lựa chọn các dòng vớ y khoa chuẩn áp lực để bảo vệ đôi chân của bạn ngay hôm nay.</p>
            <div class="mt-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 fw-bold">
                    <i class="bi bi-bag-plus me-2"></i> Khám phá sản phẩm ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Free Shipping Indicator -->
        <div class="card border-0 shadow-sm p-3 mb-4 bg-white rounded-3">
            <div class="d-flex justify-content-between align-items-center mb-1 small fw-bold">
                @if (Model.SubTotal >= freeShipThreshold)
                {
                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Chúc mừng! Bạn được MIỄN PHÍ VẬN CHUYỂN toàn quốc!</span>
                }
                else
                {
                    <span class="text-primary"><i class="bi bi-truck me-1"></i> Mua thêm @((freeShipThreshold - Model.SubTotal).ToString("N0")) ₫ để được MIỄN PHÍ VẬN CHUYỂN</span>
                }
                <span class="text-muted">@progressPercent%</span>
            </div>
            <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @progressPercent%"></div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Items Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Phân loại</th>
                                    <th>Đơn giá</th>
                                    <th style="width: 140px;">Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "https://placehold.co/100x100?text=Vớ" : item.ProductImageUrl)" 
                                                     class="rounded me-3 border" style="width: 60px; height: 60px; object-fit: contain;" alt="@item.ProductName" />
                                                <div>
                                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">Size: @item.Size</span><br />
                                            <small class="text-muted">@item.Color</small>
                                        </td>
                                        <td class="text-nowrap fw-semibold">
                                            @item.UnitPrice.ToString("N0") ₫
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary" type="button" onclick="updateCartQty(@item.Id, @(item.Quantity - 1))">-</button>
                                                <input type="number" class="form-control text-center" value="@item.Quantity" min="1" 
                                                       onchange="updateCartQty(@item.Id, parseInt(this.value) || 1)" />
                                                <button class="btn btn-outline-secondary" type="button" onclick="updateCartQty(@item.Id, @(item.Quantity + 1))">+</button>
                                            </div>
                                        </td>
                                        <td class="text-nowrap text-danger fw-bold">
                                            @item.TotalPrice.ToString("N0") ₫
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="removeCartItem(@item.Id)" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua hàng
                        </a>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="openSizeModal()">
                            <i class="bi bi-rulers me-1"></i> Kiểm tra lại size chân
                        </button>
                    </div>
                </div>
            </div>

            <!-- Summary Order Box -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 sticky-top" style="top: 80px;">
                    <h5 class="fw-bold text-dark mb-3">Tóm tắt đơn hàng</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-bold">@Model.SubTotal.ToString("N0") ₫</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí vận chuyển:</span>
                        @if (Model.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold">Miễn phí</span>
                        }
                        else
                        {
                            <span class="fw-bold">@Model.ShippingFee.ToString("N0") ₫</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Bảo hành y tế:</span>
                        <span class="text-success fw-bold">Đổi size 7 ngày</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold text-dark">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-warning btn-lg w-100 fw-bold text-dark shadow-sm">
                        <i class="bi bi-credit-card me-2"></i> Tiến Hành Đặt Hàng
                    </a>

                    <div class="mt-3 text-center small text-muted">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Thanh toán an toàn & bảo mật 100%
                    </div>
                </div>
            </div>
        </div>
    }
</div>
