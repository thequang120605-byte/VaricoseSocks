@model List<VaricoseSocks.Web.Models.ProductViewModel>
@{
    ViewData["Title"] = "Quản lý sản phẩm - Admin";
}

<div class="container py-4">
    <!-- Admin Top Nav Header -->
    <div class="glass-card bg-white p-4 mb-4 border shadow-subtle d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="pulse-indicator bg-success"></span>
                <span class="small fw-bold text-muted">HỆ THỐNG TRỰC TUYẾN 24/7</span>
            </div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-box-seam me-2"></i>Quản Lý Sản Phẩm Vớ Y Khoa
            </h3>
            <p class="text-muted small mb-0">Danh sách tất cả sản phẩm vớ y khoa, mức nén CCL và cấu hình biến thể.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Products" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                <i class="bi bi-box-seam me-1"></i> Sản phẩm
            </a>
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-receipt me-1"></i> Đơn hàng
            </a>
            <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-people me-1"></i> Khách hàng
            </a>
            <a asp-controller="Admin" asp-action="Inventory" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-boxes me-1"></i> Tồn kho
            </a>
            <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-success btn-sm rounded-pill px-3 fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Thêm mới
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">ID</th>
                        <th style="width: 70px;">Hình ảnh</th>
                        <th>Tên vớ y khoa</th>
                        <th>Danh mục</th>
                        <th>Áp lực (CCL)</th>
                        <th>Giá bán</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@p.Id</td>
                            <td>
                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/products/vo-goi-jobst-ccl2.svg" : p.ImageUrl)" 
                                     class="rounded border bg-light p-1" style="width: 50px; height: 50px; object-fit: contain;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@p.Name</div>
                                <small class="text-muted">SKU: @p.Sku | Xuất xứ: @p.Origin</small>
                            </td>
                            <td>@(p.CategoryName ?? "Y khoa")</td>
                            <td>
                                <span class="badge bg-primary rounded-pill">@p.CompressionLevelText</span>
                            </td>
                            <td class="text-danger fw-bold text-nowrap">
                                @((p.DiscountPrice ?? p.Price).ToString("N0")) ₫
                            </td>
                            <td class="text-center">
                                @if (p.StockQuantity <= 50)
                                {
                                    <span class="badge bg-danger rounded-pill px-2">@p.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-2">@p.StockQuantity</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-controller="Admin" asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?');" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" title="Xóa">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
