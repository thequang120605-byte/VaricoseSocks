@model VaricoseSocks.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển quản trị - Varicose Socks MedTech";
}

<div class="container py-4">
    <!-- Admin Top Nav Header -->
    <div class="glass-card bg-white p-4 mb-4 border shadow-subtle d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="pulse-indicator bg-success"></span>
                <span class="small fw-bold text-muted">HỆ THỐNG TRỰC TUYẾN 24/7</span>
            </div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-speedometer2 me-2"></i>Trung Tâm Quản Trị & Kho Vận Y Tế
            </h3>
            <p class="text-muted small mb-0">Theo dõi doanh số vớ y khoa, số lượng tồn kho theo size và tiến độ đơn hàng.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-box-seam me-1"></i> Quản lý sản phẩm
            </a>
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-receipt me-1"></i> Quản lý đơn hàng
            </a>
            <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
            </a>
        </div>
    </div>

    <!-- Metrics Cards with Animated Numbers -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">TỔNG DOANH THU</small>
                        <h4 class="fw-bold text-primary mb-0 mt-1">@Model.TotalRevenue.ToString("N0") ₫</h4>
                        <small class="text-success small fw-bold"><i class="bi bi-arrow-up-right me-1"></i>+18.5% tuần này</small>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">TỔNG ĐƠN HÀNG</small>
                        <h4 class="fw-bold text-success mb-0 mt-1">
                            <span class="counter-animate" data-target="@Model.TotalOrders">@Model.TotalOrders</span>
                        </h4>
                        <small class="text-success small fw-bold"><i class="bi bi-check-circle me-1"></i>Hoàn tất giao</small>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-bag-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">ĐƠN CHỜ XỬ LÝ</small>
                        <h4 class="fw-bold text-warning mb-0 mt-1">
                            <span class="counter-animate" data-target="@Model.PendingOrdersCount">@Model.PendingOrdersCount</span>
                        </h4>
                        <small class="text-muted small">Cần xác nhận sớm</small>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">SẢN PHẨM HIỆN CÓ</small>
                        <h4 class="fw-bold text-info mb-0 mt-1">
                            <span class="counter-animate" data-target="@Model.TotalProducts">@Model.TotalProducts</span>
                        </h4>
                        <small class="text-muted small">15 phân loại size</small>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Visual Area Gradient Chart Section -->
    <div class="glass-card bg-white p-4 mb-4 border shadow-subtle">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-activity text-primary me-2"></i>Biểu Đồ Xu Hướng Điều Trị & Doanh Số</h5>
                <small class="text-muted">Tỉ lệ quan tâm giữa vớ phòng ngừa CCL1 (15-20 mmHg) và vớ điều trị CCL2 (20-30 mmHg)</small>
            </div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Cập nhật theo thời gian thực</span>
        </div>

        <div class="p-3 bg-light rounded-4 border">
            <!-- Simulated High-Precision SVG Wave Area Chart -->
            <svg viewBox="0 0 800 160" class="w-100" style="height: 140px; overflow: visible;">
                <defs>
                    <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#0284c7" stop-opacity="0.4" />
                        <stop offset="100%" stop-color="#0284c7" stop-opacity="0.0" />
                    </linearGradient>
                </defs>
                <path d="M0,130 C120,110 200,60 350,75 C500,90 600,30 800,20 L800,160 L0,160 Z" fill="url(#chartGrad)"></path>
                <path d="M0,130 C120,110 200,60 350,75 C500,90 600,30 800,20" fill="none" stroke="#0284c7" stroke-width="3" stroke-linecap="round"></path>
                <!-- Key Markers -->
                <circle cx="350" cy="75" r="5" fill="#0284c7" stroke="#ffffff" stroke-width="2"></circle>
                <circle cx="800" cy="20" r="6" fill="#10b981" stroke="#ffffff" stroke-width="2"></circle>
            </svg>
            <div class="d-flex justify-content-between text-muted small mt-2" style="font-size: 0.75rem;">
                <span>Thứ 2</span>
                <span>Thứ 3</span>
                <span>Thứ 4</span>
                <span>Thứ 5</span>
                <span>Thứ 6</span>
                <span>Thứ 7</span>
                <span class="fw-bold text-primary">Hôm nay</span>
            </div>
        </div>
    </div>

    <!-- Recent Orders Table -->
    <div class="glass-card bg-white p-4 mb-4 border shadow-subtle">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-receipt-cutoff text-primary me-2"></i>Đơn hàng mới nhất</h5>
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-link text-decoration-none small fw-bold">Xem tất cả</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle small">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><strong>@o.OrderCode</strong></td>
                            <td>@o.CustomerName</td>
                            <td>@o.CustomerPhone</td>
                            <td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-danger fw-bold">@o.TotalAmount.ToString("N0") ₫</td>
                            <td>
                                <span class="badge rounded-pill @(o.OrderStatus == 5 ? "bg-success" : o.OrderStatus == 1 ? "bg-warning text-dark" : "bg-primary")">
                                    @o.OrderStatusText
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Order" asp-action="Track" asp-route-query="@o.OrderCode" class="btn btn-outline-primary btn-sm rounded-pill py-0 px-3">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Low Stock Alert Products -->
    @if (Model.LowStockProducts.Any())
    {
        <div class="glass-card bg-white p-4 border shadow-subtle">
            <h5 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-octagon text-danger me-2"></i>Cảnh báo sản phẩm tồn kho thấp</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Mã SKU</th>
                            <th>Áp lực</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/50x50" : p.ImageUrl)" 
                                             class="rounded-3 me-2 border p-1 bg-light" style="width: 38px; height: 38px; object-fit: contain;" />
                                        <span class="fw-semibold">@p.Name</span>
                                    </div>
                                </td>
                                <td>@p.Sku</td>
                                <td><span class="badge bg-secondary rounded-pill">@p.CompressionLevelText</span></td>
                                <td class="fw-bold text-danger">@p.Price.ToString("N0") ₫</td>
                                <td>
                                    <span class="badge bg-danger rounded-pill">Còn @p.StockQuantity đôi</span>
                                </td>
                                <td>
                                    <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-3">
                                        Cập nhật tồn
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
