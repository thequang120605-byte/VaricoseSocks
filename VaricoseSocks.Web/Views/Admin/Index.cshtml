@model VaricoseSocks.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển quản trị - Varicose Socks";
}

<div class="container py-4">
    <!-- Admin Top Nav Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-speedometer2 me-2"></i>Hệ Thống Quản Trị Cửa Hàng Vớ Y Khoa
            </h3>
            <p class="text-muted small mb-0">Quản lý toàn bộ danh mục, sản phẩm, tồn kho và đơn hàng khách hàng.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-box-seam me-1"></i> Quản lý sản phẩm
            </a>
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-receipt me-1"></i> Quản lý đơn hàng
            </a>
            <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
            </a>
        </div>
    </div>

    <!-- Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block">TỔNG DOANH THU</small>
                        <h4 class="fw-bold text-primary mb-0">@Model.TotalRevenue.ToString("N0") ₫</h4>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block">TỔNG ĐƠN HÀNG</small>
                        <h4 class="fw-bold text-success mb-0">@Model.TotalOrders</h4>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-bag-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block">ĐƠN CHỜ XỬ LÝ</small>
                        <h4 class="fw-bold text-warning mb-0">@Model.PendingOrdersCount</h4>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block">SẢN PHẨM HIỆN CÓ</small>
                        <h4 class="fw-bold text-info mb-0">@Model.TotalProducts</h4>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-receipt-cutoff text-primary me-2"></i>Đơn hàng mới nhất</h5>
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-link text-decoration-none small">Xem tất cả</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle small">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><strong>@o.OrderCode</strong></td>
                            <td>@o.CustomerName</td>
                            <td>@o.CustomerPhone</td>
                            <td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-danger fw-bold">@o.TotalAmount.ToString("N0") ₫</td>
                            <td>
                                <span class="badge @(o.OrderStatus == 5 ? "bg-success" : o.OrderStatus == 1 ? "bg-warning text-dark" : "bg-primary")">
                                    @o.OrderStatusText
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Order" asp-action="Track" asp-route-query="@o.OrderCode" class="btn btn-outline-primary btn-sm py-0 px-2">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Low Stock Alert Products -->
    @if (Model.LowStockProducts.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-octagon text-danger me-2"></i>Cảnh báo sản phẩm tồn kho thấp</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Mã SKU</th>
                            <th>Áp lực</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/50x50" : p.ImageUrl)" 
                                             class="rounded me-2 border" style="width: 35px; height: 35px; object-fit: contain;" />
                                        <span>@p.Name</span>
                                    </div>
                                </td>
                                <td>@p.Sku</td>
                                <td><span class="badge bg-secondary">@p.CompressionLevelText</span></td>
                                <td class="fw-bold text-danger">@p.Price.ToString("N0") ₫</td>
                                <td>
                                    <span class="badge bg-danger">Còn @p.StockQuantity đôi</span>
                                </td>
                                <td>
                                    <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm py-0 px-2">
                                        Cập nhật tồn
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
