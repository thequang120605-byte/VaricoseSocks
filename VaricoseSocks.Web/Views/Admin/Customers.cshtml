@model List<VaricoseSocks.Web.Models.AdminCustomerViewModel>
@{
    ViewData["Title"] = "Quản lý khách hàng - Varicose Socks MedTech";
    var totalCustomers = Model.Count;
    var totalOrdersAll = Model.Sum(c => c.TotalOrders);
    var totalSpentAll = Model.Sum(c => c.TotalSpent);
    var vipCustomers = Model.Count(c => c.TotalSpent >= 2000000 || c.TotalOrders >= 2);
}

<div class="container py-4">
    <!-- Admin Top Nav Header -->
    <div class="glass-card bg-white p-4 mb-4 border shadow-subtle d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="pulse-indicator bg-success"></span>
                <span class="small fw-bold text-muted">HỆ THỐNG TRỰC TUYẾN 24/7</span>
            </div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-people me-2"></i>Quản Lý Hồ Sơ Khách Hàng
            </h3>
            <p class="text-muted small mb-0">Theo dõi thông tin liên hệ, lịch sử mua sắm và tổng giá trị chi tiêu của bệnh nhân.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-box-seam me-1"></i> Sản phẩm
            </a>
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-receipt me-1"></i> Đơn hàng
            </a>
            <a asp-controller="Admin" asp-action="Customers" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                <i class="bi bi-people me-1"></i> Khách hàng
            </a>
            <a asp-controller="Admin" asp-action="Inventory" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-boxes me-1"></i> Tồn kho
            </a>
        </div>
    </div>

    <!-- Customer Statistics Overview -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">TỔNG KHÁCH HÀNG</small>
                        <h4 class="fw-bold text-primary mb-0 mt-1">@totalCustomers</h4>
                        <small class="text-success small fw-bold"><i class="bi bi-check-circle me-1"></i>Đã xác thực</small>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">TỔNG GIÁ TRỊ TÍCH LŨY</small>
                        <h4 class="fw-bold text-success mb-0 mt-1">@totalSpentAll.ToString("N0") ₫</h4>
                        <small class="text-muted small">Doanh thu đóng góp</small>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">TỔNG ĐƠN ĐÃ ĐẶT</small>
                        <h4 class="fw-bold text-warning mb-0 mt-1">@totalOrdersAll</h4>
                        <small class="text-muted small">Đơn hàng vớ y khoa</small>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="bi bi-bag-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">KHÁCH THÂN THIẾT (VIP)</small>
                        <h4 class="fw-bold text-info mb-0 mt-1">@vipCustomers</h4>
                        <small class="text-info small fw-bold"><i class="bi bi-stars me-1"></i>Tái mua định kỳ</small>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3">
                        <i class="bi bi-award fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customers Filter & Table -->
    <div class="glass-card bg-white p-4 border shadow-subtle">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-list-ul text-primary me-2"></i>Danh Sách Tài Khoản & Bệnh Nhân</h5>
                <span class="badge bg-secondary rounded-pill">@totalCustomers người</span>
            </div>
            <div class="d-flex gap-2">
                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="customerSearch" class="form-control border-start-0" placeholder="Tìm theo tên, email, sđt..." onkeyup="filterCustomers()" />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="customersTable">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Khách hàng</th>
                        <th>Thông tin liên hệ</th>
                        <th>Địa chỉ giao hàng</th>
                        <th class="text-center">Số đơn</th>
                        <th class="text-end">Tổng chi tiêu</th>
                        <th class="text-center">Vai trò</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                Chưa có dữ liệu khách hàng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model)
                        {
                            <tr class="customer-row">
                                <td class="fw-bold text-muted">#@c.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 0.9rem;">
                                            @(string.IsNullOrEmpty(c.FullName) ? "U" : c.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark customer-name">@c.FullName</div>
                                            <small class="text-muted">Ngày tạo: @c.CreatedAt.ToString("dd/MM/yyyy")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-dark customer-email"><i class="bi bi-envelope text-muted me-1"></i>@c.Email</div>
                                    <div class="small text-muted customer-phone"><i class="bi bi-telephone text-muted me-1"></i>@(string.IsNullOrEmpty(c.Phone) ? "Chưa có SĐT" : c.Phone)</div>
                                </td>
                                <td>
                                    <small class="text-dark d-block text-truncate" style="max-width: 200px;" title="@c.Address, @c.District, @c.City">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>
                                        @(string.IsNullOrEmpty(c.Address) ? "Chưa cập nhật địa chỉ" : $"{c.Address}, {c.District}, {c.City}")
                                    </small>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(c.TotalOrders > 0 ? "bg-primary" : "bg-light text-muted border") rounded-pill px-3 py-1">
                                        @c.TotalOrders đơn
                                    </span>
                                </td>
                                <td class="text-end fw-bold @(c.TotalSpent > 0 ? "text-success" : "text-muted")">
                                    @c.TotalSpent.ToString("N0") ₫
                                </td>
                                <td class="text-center">
                                    @foreach (var r in c.Roles)
                                    {
                                        <span class="badge @(r == "Admin" ? "bg-warning text-dark" : "bg-info-subtle text-info") rounded-pill px-2 py-1 small">
                                            @r
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill small">
                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 rounded-pill small">
                                            <i class="bi bi-x-circle me-1"></i>Đã khóa
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterCustomers() {
    var input = document.getElementById("customerSearch").value.toLowerCase();
    var rows = document.querySelectorAll(".customer-row");
    rows.forEach(function(r) {
        var name = r.querySelector(".customer-name") ? r.querySelector(".customer-name").innerText.toLowerCase() : "";
        var email = r.querySelector(".customer-email") ? r.querySelector(".customer-email").innerText.toLowerCase() : "";
        var phone = r.querySelector(".customer-phone") ? r.querySelector(".customer-phone").innerText.toLowerCase() : "";
        if (name.includes(input) || email.includes(input) || phone.includes(input)) {
            r.style.display = "";
        } else {
            r.style.display = "none";
        }
    });
}
</script>
