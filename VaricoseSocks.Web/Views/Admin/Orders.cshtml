@model List<VaricoseSocks.Web.Models.OrderDetailViewModel>
@{
    ViewData["Title"] = "Quản lý đơn hàng - Admin";
    int? selectedStatus = ViewBag.SelectedStatus as int?;
}

<div class="container py-4">
    <!-- Admin Top Nav Header -->
    <div class="glass-card bg-white p-4 mb-4 border shadow-subtle d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="pulse-indicator bg-success"></span>
                <span class="small fw-bold text-muted">HỆ THỐNG TRỰC TUYẾN 24/7</span>
            </div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-receipt me-2"></i>Quản Lý Đơn Hàng Vớ Y Khoa
            </h3>
            <p class="text-muted small mb-0">Theo dõi tiến độ đơn hàng, kiểm tra thanh toán VietQR và cập nhật trạng thái vận chuyển.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-box-seam me-1"></i> Sản phẩm
            </a>
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                <i class="bi bi-receipt me-1"></i> Đơn hàng
            </a>
            <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-people me-1"></i> Khách hàng
            </a>
            <a asp-controller="Admin" asp-action="Inventory" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-boxes me-1"></i> Tồn kho
            </a>
        </div>
    </div>

    <!-- Status Filter Buttons -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-controller="Admin" asp-action="Orders" class="btn btn-sm rounded-pill @(!selectedStatus.HasValue ? "btn-primary" : "btn-outline-secondary")">
            Tất cả (@Model.Count)
        </a>
        <a asp-controller="Admin" asp-action="Orders" asp-route-status="1" class="btn btn-sm rounded-pill @(selectedStatus == 1 ? "btn-warning text-dark" : "btn-outline-warning text-dark")">
            Chờ xác nhận
        </a>
        <a asp-controller="Admin" asp-action="Orders" asp-route-status="2" class="btn btn-sm rounded-pill @(selectedStatus == 2 ? "btn-info text-white" : "btn-outline-info")">
            Đã xác nhận
        </a>
        <a asp-controller="Admin" asp-action="Orders" asp-route-status="3" class="btn btn-sm rounded-pill @(selectedStatus == 3 ? "btn-secondary" : "btn-outline-secondary")">
            Đang đóng gói
        </a>
        <a asp-controller="Admin" asp-action="Orders" asp-route-status="4" class="btn btn-sm rounded-pill @(selectedStatus == 4 ? "btn-primary" : "btn-outline-primary")">
            Đang giao hàng
        </a>
        <a asp-controller="Admin" asp-action="Orders" asp-route-status="5" class="btn btn-sm rounded-pill @(selectedStatus == 5 ? "btn-success" : "btn-outline-success")">
            Hoàn thành
        </a>
    </div>

    <!-- Orders Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Địa chỉ giao</th>
                        <th>Phương thức</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái hiện tại</th>
                        <th style="min-width: 200px;">Cập nhật trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Chưa có đơn hàng nào theo điều kiện lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="text-primary">@o.OrderCode</strong><br />
                                    <small class="text-muted">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <strong>@o.CustomerName</strong><br />
                                    <small class="text-muted">@o.CustomerPhone</small>
                                </td>
                                <td style="max-width: 250px;">
                                    <span class="d-inline-block text-truncate" style="max-width: 240px;" title="@o.ShippingAddress">
                                        @o.ShippingAddress
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@o.PaymentMethodText</span>
                                </td>
                                <td class="text-danger fw-bold text-nowrap">
                                    @o.TotalAmount.ToString("N0") ₫
                                </td>
                                <td>
                                    <span class="badge @(o.OrderStatus == 5 ? "bg-success" : o.OrderStatus == 1 ? "bg-warning text-dark" : "bg-primary") rounded-pill">
                                        @o.OrderStatusText
                                    </span>
                                </td>
                                <td>
                                    <form asp-controller="Admin" asp-action="UpdateOrderStatus" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <select name="status" class="form-select form-select-sm rounded-pill" style="width: 140px;">
                                            <option value="1" selected="@(o.OrderStatus == 1)">1. Chờ xác nhận</option>
                                            <option value="2" selected="@(o.OrderStatus == 2)">2. Đã xác nhận</option>
                                            <option value="3" selected="@(o.OrderStatus == 3)">3. Đang đóng gói</option>
                                            <option value="4" selected="@(o.OrderStatus == 4)">4. Đang giao hàng</option>
                                            <option value="5" selected="@(o.OrderStatus == 5)">5. Hoàn thành</option>
                                            <option value="6" selected="@(o.OrderStatus == 6)">6. Đã hủy</option>
                                        </select>
                                        <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill" title="Lưu">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
