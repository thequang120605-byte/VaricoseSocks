@model List<VaricoseSocks.Web.Models.InventoryStatusViewModel>
@{
    ViewData["Title"] = "Quản lý tồn kho vớ y khoa - Varicose Socks MedTech";
    var totalStock = Model.Sum(p => p.StockQuantity);
    var lowStockCount = Model.Count(p => p.StockQuantity <= 50);
    var totalVariants = Model.Sum(p => p.Variants.Count);
    var outOfStockCount = Model.Count(p => p.StockQuantity == 0);
}

<div class="container py-4">
    <!-- Admin Top Nav Header -->
    <div class="glass-card bg-white p-4 mb-4 border shadow-subtle d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="pulse-indicator bg-success"></span>
                <span class="small fw-bold text-muted">HỆ THỐNG TRỰC TUYẾN 24/7</span>
            </div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-boxes me-2"></i>Quản Trị Tồn Kho Vớ Y Khoa & Biến Thể
            </h3>
            <p class="text-muted small mb-0">Theo dõi tồn kho theo kích thước (S/M/L/XL), màu da/đen và cảnh báo ngưỡng an toàn.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-box-seam me-1"></i> Sản phẩm
            </a>
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-receipt me-1"></i> Đơn hàng
            </a>
            <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-people me-1"></i> Khách hàng
            </a>
            <a asp-controller="Admin" asp-action="Inventory" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                <i class="bi bi-boxes me-1"></i> Tồn kho
            </a>
        </div>
    </div>

    <!-- Inventory Overview KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">TỔNG VỚ TRONG KHO</small>
                        <h4 class="fw-bold text-primary mb-0 mt-1">@totalStock đôi</h4>
                        <small class="text-muted small">@Model.Count mặt hàng</small>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-box-seam-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">TỔNG BIẾN THỂ SIZE/MÀU</small>
                        <h4 class="fw-bold text-info mb-0 mt-1">@totalVariants SKU</h4>
                        <small class="text-info small fw-bold">Chi tiết theo kích cỡ</small>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">MẶT HÀNG SẮP HẾT (≤50)</small>
                        <h4 class="fw-bold text-warning mb-0 mt-1">@lowStockCount</h4>
                        <small class="text-warning small fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Cần nhập thêm</small>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="bi bi-bell fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-4 bg-white border shadow-subtle h-100 border-start border-4 @(outOfStockCount > 0 ? "border-danger" : "border-success")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted fw-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.05em;">MẶT HÀNG HẾT HÀNG</small>
                        <h4 class="fw-bold @(outOfStockCount > 0 ? "text-danger" : "text-success") mb-0 mt-1">@outOfStockCount</h4>
                        <small class="text-muted small">Cần bổ sung ngay</small>
                    </div>
                    <div class="bg-light text-secondary rounded-circle p-3">
                        <i class="bi bi-slash-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Table Card -->
    <div class="glass-card bg-white p-4 border shadow-subtle">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clipboard-data text-primary me-2"></i>Bảng Kiểm Kê Tồn Kho Theo Dòng Vớ</h5>
                <span class="badge bg-secondary rounded-pill">@Model.Count dòng sản phẩm</span>
            </div>
            <div class="d-flex gap-2">
                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="inventorySearch" class="form-control border-start-0" placeholder="Tìm theo tên vớ, SKU..." onkeyup="filterInventory()" />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="inventoryTable">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th style="width: 50px;"></th>
                        <th style="width: 70px;">ID</th>
                        <th>Dòng sản phẩm vớ</th>
                        <th>Mã SKU gốc</th>
                        <th class="text-center">Tổng tồn kho</th>
                        <th class="text-center">Số biến thể</th>
                        <th class="text-center">Trạng thái kho</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-boxes fs-1 d-block mb-2 text-secondary"></i>
                                Chưa có dữ liệu tồn kho.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var collapseId = "collapseVar_" + item.Id;
                            <tr class="inventory-row">
                                <td class="text-center">
                                    @if (item.Variants.Any())
                                    {
                                        <button class="btn btn-sm btn-outline-secondary rounded-circle p-0" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="width: 24px; height: 24px;" title="Xem chi tiết các size">
                                            <i class="bi bi-chevron-down" style="font-size: 0.75rem;"></i>
                                        </button>
                                    }
                                </td>
                                <td class="fw-bold text-muted">#@item.Id</td>
                                <td>
                                    <div class="fw-bold text-dark item-name">@item.Name</div>
                                </td>
                                <td>
                                    <code class="text-dark bg-light px-2 py-1 rounded item-sku">@item.Sku</code>
                                </td>
                                <td class="text-center">
                                    <span class="fs-6 fw-bold @(item.StockQuantity <= 50 ? "text-danger" : "text-primary")">
                                        @item.StockQuantity đôi
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border rounded-pill">
                                        @item.Variants.Count biến thể
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-1 rounded-pill">
                                            <i class="bi bi-x-circle me-1"></i>Hết hàng
                                        </span>
                                    }
                                    else if (item.StockQuantity <= 50)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning px-3 py-1 rounded-pill">
                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Sắp hết hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i>Còn hàng dồi dào
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-pencil me-1"></i>Cập nhật
                                    </a>
                                </td>
                            </tr>

                            @if (item.Variants.Any())
                            {
                                <tr class="collapse bg-light p-0" id="@collapseId">
                                    <td colspan="8" class="p-3">
                                        <div class="card border rounded-3 p-3 bg-white">
                                            <h6 class="fw-bold text-secondary mb-2 small"><i class="bi bi-tag-fill me-1"></i>Chi tiết biến thể theo Size & Màu sắc của: <strong>@item.Name</strong></h6>
                                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-2">
                                                @foreach (var v in item.Variants)
                                                {
                                                    <div class="col">
                                                        <div class="p-2 border rounded-3 text-center bg-light">
                                                            <div class="small fw-bold text-dark">Size: @v.Size</div>
                                                            <div class="small text-muted mb-1" style="font-size: 0.72rem;">@v.Color</div>
                                                            <span class="badge @(v.StockQuantity <= 10 ? "bg-danger" : "bg-primary") rounded-pill px-2">
                                                                @v.StockQuantity đôi
                                                            </span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterInventory() {
    var input = document.getElementById("inventorySearch").value.toLowerCase();
    var rows = document.querySelectorAll(".inventory-row");
    rows.forEach(function(r) {
        var name = r.querySelector(".item-name") ? r.querySelector(".item-name").innerText.toLowerCase() : "";
        var sku = r.querySelector(".item-sku") ? r.querySelector(".item-sku").innerText.toLowerCase() : "";
        if (name.includes(input) || sku.includes(input)) {
            r.style.display = "";
        } else {
            r.style.display = "none";
        }
    });
}
</script>
