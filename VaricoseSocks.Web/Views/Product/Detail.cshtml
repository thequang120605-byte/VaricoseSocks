@model VaricoseSocks.Web.Models.ProductViewModel
@{
    ViewData["Title"] = Model.Name + " - Chi tiết sản phẩm";
    var related = ViewBag.RelatedProducts as List<VaricoseSocks.Web.Models.ProductViewModel> ?? new();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Product Summary Card -->
    <div class="card border-0 shadow-sm p-4 mb-5 bg-white rounded-4">
        <div class="row g-4">
            <!-- Left: Product Image -->
            <div class="col-lg-5 text-center">
                <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-center" style="min-height: 400px;">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/400x400?text=Vớ+Y+Khoa" : Model.ImageUrl)" 
                         class="img-fluid" alt="@Model.Name" style="max-height: 380px; object-fit: contain;" />
                </div>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <span class="badge bg-success-subtle text-success border border-success p-2 small">
                        <i class="bi bi-shield-check me-1"></i> 100% Chính hãng @(Model.Brand ?? "Y khoa")
                    </span>
                    <span class="badge bg-info-subtle text-info border border-info p-2 small">
                        <i class="bi bi-geo-alt me-1"></i> Xuất xứ: @(Model.Origin ?? "Mỹ / Đức")
                    </span>
                </div>
            </div>

            <!-- Right: Product Information & Purchase -->
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary fs-6">@Model.CompressionLevelText</span>
                    <span class="badge bg-light text-secondary border">@(Model.CategoryName ?? "Vớ y khoa")</span>
                    <span class="badge bg-light text-secondary border">Mã: @(Model.Sku ?? "VS-MED")</span>
                </div>

                <h2 class="fw-bold text-dark mb-2">@Model.Name</h2>
                <p class="text-muted small">@Model.ShortDescription</p>

                <!-- Price Box -->
                <div class="p-3 bg-light rounded-3 d-flex align-items-baseline gap-3 mb-4">
                    <span class="text-danger fw-bold fs-3">
                        @((Model.DiscountPrice ?? Model.Price).ToString("N0")) ₫
                    </span>
                    @if (Model.DiscountPrice.HasValue && Model.DiscountPrice < Model.Price)
                    {
                        <span class="text-muted text-decoration-line-through fs-5">
                            @Model.Price.ToString("N0") ₫
                        </span>
                        <span class="badge bg-danger">Tiết kiệm @((Model.Price - Model.DiscountPrice.Value).ToString("N0")) ₫</span>
                    }
                </div>

                <!-- Specs Grid -->
                <div class="row g-2 mb-4 small">
                    <div class="col-6 col-md-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block">Kiểu dáng:</span>
                            <strong>@Model.StyleText</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block">Kiểu ngón:</span>
                            <strong>@Model.ToeTypeText</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block">Thương hiệu:</span>
                            <strong>@(Model.Brand ?? "Chính hãng")</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block">Chất liệu:</span>
                            <strong>@(Model.Material ?? "Polyamide, Elastane")</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block">Tình trạng:</span>
                            <strong class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Còn hàng (@Model.StockQuantity đôi)</strong>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="p-2 border rounded bg-white">
                            <span class="text-muted d-block">Đo size:</span>
                            <a href="javascript:void(0)" class="text-primary fw-bold text-decoration-none" onclick="openSizeModal()">
                                <i class="bi bi-rulers"></i> Xem bảng size
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Size & Color Selection -->
                <div class="mb-3">
                    <label class="form-label fw-bold d-flex justify-content-between">
                        <span>Chọn Size (Kích thước chân):</span>
                        <a href="javascript:void(0)" class="small text-primary text-decoration-none" onclick="openSizeModal()">Bạn chưa biết chọn size nào?</a>
                    </label>
                    <div class="d-flex gap-2" id="sizeSelector">
                        <button type="button" class="btn btn-outline-primary active btn-size px-3 py-2 fw-bold" onclick="selectSize(this, 'S')">S</button>
                        <button type="button" class="btn btn-outline-primary btn-size px-3 py-2 fw-bold" onclick="selectSize(this, 'M')">M</button>
                        <button type="button" class="btn btn-outline-primary btn-size px-3 py-2 fw-bold" onclick="selectSize(this, 'L')">L</button>
                        <button type="button" class="btn btn-outline-primary btn-size px-3 py-2 fw-bold" onclick="selectSize(this, 'XL')">XL</button>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Màu sắc:</label>
                    <div class="d-flex gap-2" id="colorSelector">
                        <button type="button" class="btn btn-outline-secondary active btn-color px-3 py-2" onclick="selectColor(this, 'Màu Da (Beige)')">
                            <i class="bi bi-circle-fill text-warning me-1"></i> Màu Da (Beige)
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-color px-3 py-2" onclick="selectColor(this, 'Màu Đen (Black)')">
                            <i class="bi bi-circle-fill text-dark me-1"></i> Màu Đen (Black)
                        </button>
                    </div>
                </div>

                <!-- Quantity & Buttons -->
                <div class="d-flex align-items-center gap-3">
                    <div class="input-group" style="width: 130px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="decrementDetailQty()">-</button>
                        <input type="number" id="detailQty" class="form-control text-center" value="1" min="1" max="@Model.StockQuantity" />
                        <button class="btn btn-outline-secondary" type="button" onclick="incrementDetailQty(@Model.StockQuantity)">+</button>
                    </div>

                    <button type="button" class="btn btn-outline-primary btn-lg fw-bold flex-grow-1" onclick="handleDetailAddToCart()">
                        <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ hàng
                    </button>

                    <button type="button" class="btn btn-warning btn-lg fw-bold text-dark flex-grow-1" onclick="handleDetailBuyNow()">
                        <i class="bi bi-lightning-fill me-1"></i> Mua ngay
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Description & Medical Guidance Tabs -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
        <ul class="nav nav-tabs nav-fill mb-3" id="productTab" role="tablist">
            <li class="nav-item">
                <button class="nav-link active fw-bold" id="desc-tab" data-bs-toggle="tab" data-bs-target="#descContent">
                    <i class="bi bi-file-text me-1"></i> Mô tả chi tiết & Tác dụng
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-bold" id="guide-tab" data-bs-toggle="tab" data-bs-target="#guideContent">
                    <i class="bi bi-info-circle me-1"></i> Hướng dẫn mang & bảo quản
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-bold" id="indication-tab" data-bs-toggle="tab" data-bs-target="#indicationContent">
                    <i class="bi bi-shield-plus me-1"></i> Chỉ định y khoa
                </button>
            </li>
        </ul>

        <div class="tab-content p-3" id="productTabContent">
            <div class="tab-pane fade show active" id="descContent">
                <h5 class="fw-bold text-primary mb-3">Mô tả sản phẩm @Model.Name</h5>
                <p>@(string.IsNullOrEmpty(Model.Description) ? Model.ShortDescription : Model.Description)</p>
                <div class="alert alert-info">
                    <strong>Lưu ý quan trọng:</strong> Vớ y khoa tác động theo cơ chế vật lý cơ học, không chứa hóa chất hay tác dụng phụ. Hiệu quả cải thiện dòng máu chảy ngược giảm cảm giác nặng chân có thể thấy rõ ngay trong ngày đầu tiên sử dụng.
                </div>
            </div>

            <div class="tab-pane fade" id="guideContent">
                <h5 class="fw-bold text-primary mb-3">Cách mang vớ y khoa đúng kỹ thuật:</h5>
                <ol class="text-secondary lh-lg">
                    <li>Nên mang vớ vào <strong>buổi sáng sớm</strong> ngay sau khi ngủ dậy, lúc này chân chưa bị dồn máu và chưa sưng phù.</li>
                    <li>Lộn mặt trái của vớ ra ngoài đến phần gót chân, xỏ bàn chân vào đúng vị trí gót.</li>
                    <li>Từ từ vuốt đều thân vớ lên cẳng chân, tuyệt đối không dùng móng tay cào hoặc kéo giật mép vớ quá mạnh.</li>
                    <li>Giặt tay bằng nước ấm hoặc nước lạnh với xà phòng trung tính, phơi trong bóng râm, không ủi (là) hoặc sấy nhiệt độ cao.</li>
                </ol>
            </div>

            <div class="tab-pane fade" id="indicationContent">
                <h5 class="fw-bold text-primary mb-3">Chỉ định & Chống chỉ định:</h5>
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-success"><i class="bi bi-check-circle me-1"></i>Chỉ định sử dụng:</h6>
                        <ul class="text-muted small">
                            <li>Người bị cảm giác nặng mỏi, tê bì chân về chiều tối.</li>
                            <li>Tĩnh mạch nổi gân xanh ngoằn ngoèo, phù mắt cá chân.</li>
                            <li>Người làm việc phải đứng hoặc ngồi bất động trong nhiều giờ (giáo viên, lễ tân, tài xế, văn phòng).</li>
                            <li>Phụ nữ trong thai kỳ bị nặng chân, chuột rút.</li>
                            <li>Bệnh nhân sau can thiệp tiêm xơ tĩnh mạch hoặc phẫu thuật Laser nội mạch.</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-danger"><i class="bi bi-x-circle me-1"></i>Chống chỉ định:</h6>
                        <ul class="text-muted small">
                            <li>Bệnh lý tắc động mạch chi dưới tiến triển (chỉ số ABI < 0.6).</li>
                            <li>Viêm tắc tĩnh mạch có nhiễm trùng hở cấp tính chưa kiểm soát.</li>
                            <li>Dị ứng mẫn cảm với thành phần sợi dệt của vớ.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <h4 class="fw-bold text-primary mb-3">Sản phẩm liên quan cùng danh mục</h4>
        <div class="row row-cols-1 row-cols-md-4 g-4 mb-4">
            @foreach (var rp in related)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <a asp-controller="Product" asp-action="Detail" asp-route-id="@rp.Id" class="text-center p-3 bg-white">
                            <img src="@(string.IsNullOrEmpty(rp.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : rp.ImageUrl)" 
                                 class="card-img-top" alt="@rp.Name" style="height: 160px; object-fit: contain;">
                        </a>
                        <div class="card-body d-flex flex-column pt-1">
                            <span class="badge bg-light text-secondary border align-self-start mb-1" style="font-size: 0.7rem;">@rp.CompressionLevelText</span>
                            <h6 class="card-title fw-bold">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@rp.Id" class="text-decoration-none text-dark">
                                    @rp.Name
                                </a>
                            </h6>
                            <div class="text-danger fw-bold mt-auto">
                                @((rp.DiscountPrice ?? rp.Price).ToString("N0")) ₫
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    let currentSelectedSize = 'M';
    let currentSelectedColor = 'Màu Da (Beige)';

    function selectSize(btn, size) {
        document.querySelectorAll('#sizeSelector .btn-size').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentSelectedSize = size;
    }

    function selectColor(btn, color) {
        document.querySelectorAll('#colorSelector .btn-color').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentSelectedColor = color;
    }

    function incrementDetailQty(max) {
        const input = document.getElementById('detailQty');
        let val = parseInt(input.value) || 1;
        if (val < max) input.value = val + 1;
    }

    function decrementDetailQty() {
        const input = document.getElementById('detailQty');
        let val = parseInt(input.value) || 1;
        if (val > 1) input.value = val - 1;
    }

    function handleDetailAddToCart() {
        const qty = parseInt(document.getElementById('detailQty').value) || 1;
        addToCartLive(@Model.Id, currentSelectedSize, currentSelectedColor, qty);
    }

    async function handleDetailBuyNow() {
        const qty = parseInt(document.getElementById('detailQty').value) || 1;
        await addToCartLive(@Model.Id, currentSelectedSize, currentSelectedColor, qty);
        window.location.href = '/Checkout';
    }
</script>
}