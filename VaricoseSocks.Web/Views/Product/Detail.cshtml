@model VaricoseSocks.Web.Models.ProductViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <div class="col-md-5 text-center mb-4">
            <div class="card border-0 shadow-sm p-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/400x400?text=Vớ+Y+Khoa" : Model.ImageUrl)" class="img-fluid" alt="@Model.Name" style="max-height: 400px; object-fit: contain;" />
            </div>
        </div>
        <div class="col-md-7">
            <h2 class="fw-bold mb-3">@Model.Name</h2>
            <p class="text-muted">Danh mục: <strong>@(Model.CategoryName ?? "Vớ giãn tĩnh mạch")</strong></p>
            <div class="h3 text-danger fw-bold mb-4">@Model.Price.ToString("N0") ₫</div>

            <div class="card bg-light border-0 mb-4 p-3">
                <div class="row g-2">
                    <div class="col-6"><strong>Cấp độ nén:</strong> @(Model.CompressionLevel ?? "CCL1 (18-21 mmHg)")</div>
                    <div class="col-6"><strong>Kích cỡ (Size):</strong> @(Model.Size ?? "Tiêu chuẩn")</div>
                    <div class="col-6"><strong>Màu sắc:</strong> @(Model.Color ?? "Da / Đen")</div>
                    <div class="col-6"><strong>Tình trạng kho:</strong> @(Model.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")</div>
                </div>
            </div>

            <p class="text-secondary">@Model.Description</p>

            <div class="d-flex align-items-center gap-3 mt-4">
                <input type="number" id="buyQty" class="form-control" value="1" min="1" max="@Model.StockQuantity" style="width: 80px;" />
                <button class="btn btn-primary btn-lg" onclick="addToCart(@Model.Id, '@Model.Name', @Model.Price)">
                    <i class="bi bi-cart-plus me-2"></i>Thêm vào giỏ hàng
                </button>
            </div>
        </div>
    </div>
</div>