@model VaricoseSocks.Web.Models.ProductViewModel
@{
    ViewData["Title"] = Model.Name + " - Chi tiết sản phẩm vớ y khoa";
    var related = ViewBag.RelatedProducts as List<VaricoseSocks.Web.Models.ProductViewModel> ?? new();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-decoration-none">Sản phẩm</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 320px;" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Product Summary Card -->
    <div class="glass-card p-4 p-md-5 mb-5 bg-white border shadow-subtle position-relative">
        <div class="row g-5">
            <!-- Left: Product Image & Interactive Showcase -->
            <div class="col-lg-5 text-center">
                <div class="p-4 border rounded-4 bg-light d-flex align-items-center justify-content-center position-relative shadow-sm" style="min-height: 420px; background: radial-gradient(circle, #f8fafc 0%, #e2e8f0 100%);">
                    <img id="mainProductImg" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/400x400?text=Vớ+Y+Khoa" : Model.ImageUrl)" 
                         class="img-fluid transition-all" alt="@Model.Name" style="max-height: 380px; object-fit: contain; filter: drop-shadow(0 15px 25px rgba(0,0,0,0.12));" />
                    
                    <span class="position-absolute bottom-0 end-0 m-3 badge bg-white text-dark border shadow-sm p-2 rounded-pill small">
                        <i class="bi bi-zoom-in text-primary me-1"></i> Sợi dệt 3D Microfiber
                    </span>
                </div>

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <span class="badge bg-success-subtle text-success border border-success p-2 small rounded-pill">
                        <i class="bi bi-shield-check me-1"></i> 100% Chính hãng @(Model.Brand ?? "Y khoa")
                    </span>
                    <span class="badge bg-info-subtle text-info border border-info p-2 small rounded-pill">
                        <i class="bi bi-geo-alt me-1"></i> Xuất xứ: @(Model.Origin ?? "Mỹ / Đức")
                    </span>
                </div>

                <!-- Pressure Gradient Gauge -->
                <div class="mt-4 p-3 bg-light rounded-4 border text-start">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-dark"><i class="bi bi-graph-down text-primary me-1"></i>Chuẩn Nén Giảm Dần:</span>
                        <span class="badge bg-primary">RAL-GZ 387</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 small text-muted mb-1">
                        <span style="width: 80px;">Cổ chân:</span>
                        <div class="progress flex-grow-1" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: 100%;"></div>
                        </div>
                        <span class="fw-bold text-dark">100% lực</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 small text-muted mb-1">
                        <span style="width: 80px;">Bắp chân:</span>
                        <div class="progress flex-grow-1" style="height: 6px;">
                            <div class="progress-bar bg-info" style="width: 70%;"></div>
                        </div>
                        <span class="fw-bold text-dark">70% lực</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <span style="width: 80px;">Đùi:</span>
                        <div class="progress flex-grow-1" style="height: 6px;">
                            <div class="progress-bar bg-secondary" style="width: 40%;"></div>
                        </div>
                        <span class="fw-bold text-dark">40% lực</span>
                    </div>
                </div>
            </div>

            <!-- Right: Product Information & Purchase -->
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge badge-ccl @(Model.CompressionLevel == 2 ? "badge-ccl2" : "badge-ccl1")">
                        @Model.CompressionLevelText
                    </span>
                    <span class="badge bg-light text-secondary border">@(Model.CategoryName ?? "Vớ y khoa")</span>
                    <span class="badge bg-light text-secondary border">Mã: @(Model.Sku ?? "VS-MED")</span>
                </div>

                <h2 class="fw-bold text-dark mb-2">@Model.Name</h2>
                <p class="text-muted small mb-4">@Model.ShortDescription</p>

                <!-- Price Box -->
                <div class="p-3 bg-light rounded-4 d-flex align-items-baseline gap-3 mb-4 border">
                    <span class="text-danger fw-bold fs-2">
                        @((Model.DiscountPrice ?? Model.Price).ToString("N0")) ₫
                    </span>
                    @if (Model.DiscountPrice.HasValue && Model.DiscountPrice < Model.Price)
                    {
                        <span class="text-muted text-decoration-line-through fs-5">
                            @Model.Price.ToString("N0") ₫
                        </span>
                        <span class="badge bg-danger rounded-pill">Tiết kiệm @((Model.Price - Model.DiscountPrice.Value).ToString("N0")) ₫</span>
                    }
                </div>

                <!-- Interactive Sizing Ruler Slider (cB) -->
                <div class="p-3 bg-white rounded-4 border mb-4 shadow-subtle">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0 text-dark">
                            <i class="bi bi-rulers text-primary me-1"></i>Thước đo chu vi cổ chân (cB):
                        </label>
                        <span id="liveAnkleDisplay" class="badge bg-primary fs-6 px-3 py-1 rounded-pill">23 cm</span>
                    </div>
                    <input type="range" class="form-range" id="liveAnkleSlider" min="18" max="33" step="0.5" value="23" />
                    <div class="d-flex justify-content-between text-muted small" style="font-size: 0.72rem;">
                        <span>18cm (Size S)</span>
                        <span>22cm (Size M)</span>
                        <span>26cm (Size L)</span>
                        <span>30cm+ (Size XL)</span>
                    </div>
                    <div class="small text-muted mt-2" id="liveSizeAdvice">
                        Dựa trên số đo cổ chân 23cm, <strong>Size M</strong> sẽ ôm vừa khít và đạt hiệu quả đẩy máu về tim tốt nhất.
                    </div>
                </div>

                <!-- Size & Color Selection -->
                <div class="mb-3">
                    <label class="form-label fw-bold d-flex justify-content-between">
                        <span>Chọn Size (Kích thước chân):</span>
                        <a href="javascript:void(0)" class="small text-primary text-decoration-none" onclick="openSizeModal()">Bạn chưa biết chọn size nào?</a>
                    </label>
                    <div class="d-flex gap-2" id="sizeSelector">
                        <button type="button" class="btn btn-outline-primary btn-size px-4 py-2 fw-bold rounded-pill" onclick="selectSize(this, 'S')">S</button>
                        <button type="button" class="btn btn-outline-primary active btn-size px-4 py-2 fw-bold rounded-pill" onclick="selectSize(this, 'M')">M</button>
                        <button type="button" class="btn btn-outline-primary btn-size px-4 py-2 fw-bold rounded-pill" onclick="selectSize(this, 'L')">L</button>
                        <button type="button" class="btn btn-outline-primary btn-size px-4 py-2 fw-bold rounded-pill" onclick="selectSize(this, 'XL')">XL</button>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Màu sắc:</label>
                    <div class="d-flex gap-2" id="colorSelector">
                        <button type="button" class="btn btn-outline-secondary active btn-color px-3 py-2 rounded-pill" onclick="selectColor(this, 'Màu Da (Beige)')">
                            <i class="bi bi-circle-fill text-warning me-1"></i> Màu Da (Beige)
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-color px-3 py-2 rounded-pill" onclick="selectColor(this, 'Màu Đen (Black)')">
                            <i class="bi bi-circle-fill text-dark me-1"></i> Màu Đen (Black)
                        </button>
                    </div>
                </div>

                <!-- Quantity & Action Buttons -->
                <div class="d-flex align-items-center gap-3 flex-wrap" id="mainBuyBtn">
                    <div class="input-group" style="width: 130px;">
                        <button class="btn btn-outline-secondary rounded-start-pill" type="button" onclick="decrementDetailQty()">-</button>
                        <input type="number" id="detailQty" class="form-control text-center fw-bold" value="1" min="1" max="@Model.StockQuantity" />
                        <button class="btn btn-outline-secondary rounded-end-pill" type="button" onclick="incrementDetailQty(@Model.StockQuantity)">+</button>
                    </div>

                    <button type="button" class="btn btn-outline-primary btn-lg fw-bold rounded-pill flex-grow-1 py-3" onclick="handleDetailAddToCart()">
                        <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ
                    </button>

                    <button type="button" class="btn btn-warning btn-lg fw-bold text-dark rounded-pill flex-grow-1 py-3 shadow-glow-warning" onclick="handleDetailBuyNow()">
                        <i class="bi bi-lightning-fill me-1"></i> Mua ngay
                    </button>
                </div>

                <div class="d-flex gap-4 mt-4 pt-3 border-top text-muted small">
                    <div><i class="bi bi-truck text-primary me-1"></i> Giao hàng toàn quốc</div>
                    <div><i class="bi bi-arrow-repeat text-success me-1"></i> Đổi size 7 ngày</div>
                    <div><i class="bi bi-shield-check text-info me-1"></i> Cam kết 100% chính hãng</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sticky Mobile Bottom Buy Bar -->
    <div class="sticky-mobile-buy-bar d-md-none">
        <div class="d-flex justify-content-between align-items-center gap-3">
            <div>
                <div class="text-danger fw-bold fs-6">@((Model.DiscountPrice ?? Model.Price).ToString("N0")) ₫</div>
                <small class="text-muted" id="mobileSelectedSizeText">Size: M | Da</small>
            </div>
            <button type="button" class="btn btn-warning fw-bold text-dark rounded-pill px-4 py-2" onclick="handleDetailBuyNow()">
                <i class="bi bi-lightning-fill me-1"></i> Mua Ngay
            </button>
        </div>
    </div>

    <!-- Product Description & Medical Guidance Tabs -->
    <div class="glass-card rounded-4 p-4 mb-5 bg-white border shadow-subtle">
        <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded-pill" id="productTab" role="tablist">
            <li class="nav-item">
                <button class="nav-link active rounded-pill fw-bold" id="desc-tab" data-bs-toggle="tab" data-bs-target="#descContent">
                    <i class="bi bi-file-text me-1"></i> Mô tả chi tiết & Tác dụng
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-bold" id="guide-tab" data-bs-toggle="tab" data-bs-target="#guideContent">
                    <i class="bi bi-info-circle me-1"></i> Hướng dẫn mang & bảo quản
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill fw-bold" id="indication-tab" data-bs-toggle="tab" data-bs-target="#indicationContent">
                    <i class="bi bi-shield-plus me-1"></i> Chỉ định y khoa
                </button>
            </li>
        </ul>

        <div class="tab-content p-3" id="productTabContent">
            <div class="tab-pane fade show active" id="descContent">
                <h5 class="fw-bold text-primary mb-3">Mô tả sản phẩm @Model.Name</h5>
                <p class="text-secondary lh-lg">@(string.IsNullOrEmpty(Model.Description) ? Model.ShortDescription : Model.Description)</p>
                <div class="alert alert-info rounded-3 border-0">
                    <strong>Lưu ý quan trọng:</strong> Vớ y khoa tác động theo cơ chế vật lý cơ học, không chứa hóa chất hay tác dụng phụ. Hiệu quả cải thiện dòng máu chảy ngược giảm cảm giác nặng chân có thể thấy rõ ngay trong ngày đầu tiên sử dụng.
                </div>
            </div>

            <div class="tab-pane fade" id="guideContent">
                <h5 class="fw-bold text-primary mb-3">Cách mang vớ y khoa đúng kỹ thuật:</h5>
                <ol class="text-secondary lh-lg">
                    <li>Nên mang vớ vào <strong>buổi sáng sớm</strong> ngay sau khi ngủ dậy, lúc này chân chưa bị dồn máu và chưa sưng phù.</li>
                    <li>Lộn mặt trái của vớ ra ngoài đến phần gót chân, xỏ bàn chân vào đúng vị trí gót.</li>
                    <li>Từ từ vuốt đều thân vớ lên cẳng chân, tuyệt đối không dùng móng tay cào hoặc kéo giật mép vớ quá mạnh.</li>
                    <li>Giặt tay bằng nước ấm hoặc nước lạnh với xà phòng trung tính, phơi trong bóng râm, không ủi (là) hoặc sấy nhiệt độ cao.</li>
                </ol>
            </div>

            <div class="tab-pane fade" id="indicationContent">
                <h5 class="fw-bold text-primary mb-3">Chỉ định & Chống chỉ định y khoa:</h5>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border">
                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-check-circle me-1"></i>Chỉ định sử dụng:</h6>
                            <ul class="text-muted small mb-0 lh-lg">
                                <li>Người bị cảm giác nặng mỏi, tê bì chân về chiều tối.</li>
                                <li>Tĩnh mạch nổi gân xanh ngoằn ngoèo, phù mắt cá chân.</li>
                                <li>Người làm việc phải đứng hoặc ngồi bất động trong nhiều giờ (giáo viên, lễ tân, tài xế, văn phòng).</li>
                                <li>Phụ nữ trong thai kỳ bị nặng chân, chuột rút.</li>
                                <li>Bệnh nhân sau can thiệp tiêm xơ tĩnh mạch hoặc phẫu thuật Laser nội mạch.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4 border">
                            <h6 class="fw-bold text-danger mb-2"><i class="bi bi-x-circle me-1"></i>Chống chỉ định:</h6>
                            <ul class="text-muted small mb-0 lh-lg">
                                <li>Bệnh lý tắc động mạch chi dưới tiến triển (chỉ số ABI < 0.6).</li>
                                <li>Viêm tắc tĩnh mạch có nhiễm trùng hở cấp tính chưa kiểm soát.</li>
                                <li>Dị ứng mẫn cảm với thành phần sợi dệt của vớ.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <h4 class="fw-bold text-primary mb-3">Sản phẩm liên quan cùng danh mục</h4>
        <div class="row row-cols-1 row-cols-md-4 g-4 mb-4">
            @foreach (var rp in related)
            {
                <div class="col">
                    <div class="card h-100 product-card shadow-subtle border-0">
                        <a asp-controller="Product" asp-action="Detail" asp-route-id="@rp.Id" class="card-img-wrapper text-center d-block">
                            <img src="@(string.IsNullOrEmpty(rp.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : rp.ImageUrl)" 
                                 class="card-img-top" alt="@rp.Name" style="height: 160px; object-fit: contain;">
                        </a>
                        <div class="card-body d-flex flex-column pt-2 p-3">
                            <span class="badge bg-light text-secondary border align-self-start mb-1" style="font-size: 0.7rem;">@rp.CompressionLevelText</span>
                            <h6 class="card-title fw-bold">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@rp.Id" class="text-decoration-none text-dark hover-primary">
                                    @rp.Name
                                </a>
                            </h6>
                            <div class="text-danger fw-bold mt-auto">
                                @((rp.DiscountPrice ?? rp.Price).ToString("N0")) ₫
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    let currentSelectedSize = 'M';
    let currentSelectedColor = 'Màu Da (Beige)';

    function selectSize(btn, size) {
        document.querySelectorAll('#sizeSelector .btn-size').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentSelectedSize = size;
        updateMobileBarText();
    }

    function selectColor(btn, color) {
        document.querySelectorAll('#colorSelector .btn-color').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentSelectedColor = color;
        updateMobileBarText();
    }

    function updateMobileBarText() {
        const textEl = document.getElementById('mobileSelectedSizeText');
        if (textEl) {
            textEl.innerText = `Size: ${currentSelectedSize} | ${currentSelectedColor}`;
        }
    }

    function incrementDetailQty(max) {
        const input = document.getElementById('detailQty');
        let val = parseInt(input.value) || 1;
        if (val < max) input.value = val + 1;
    }

    function decrementDetailQty() {
        const input = document.getElementById('detailQty');
        let val = parseInt(input.value) || 1;
        if (val > 1) input.value = val - 1;
    }

    function handleDetailAddToCart() {
        const qty = parseInt(document.getElementById('detailQty').value) || 1;
        const img = document.getElementById('mainProductImg');
        addToCartLive(@Model.Id, currentSelectedSize, currentSelectedColor, qty, img);
    }

    async function handleDetailBuyNow() {
        const qty = parseInt(document.getElementById('detailQty').value) || 1;
        await addToCartLive(@Model.Id, currentSelectedSize, currentSelectedColor, qty);
        window.location.href = '/Checkout';
    }
</script>
}
