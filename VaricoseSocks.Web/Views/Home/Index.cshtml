@model VaricoseSocks.Web.Models.ProductListViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="bg-primary text-white py-5 text-center shadow-sm mb-5" style="background: linear-gradient(135deg, #0d6efd, #0b5ed7);">
    <div class="container py-4">
        <h1 class="display-5 fw-bold">GIẢI PHÁP CHO ĐÔI CHÂN KHỎE MẠNH</h1>
        <p class="lead col-lg-8 mx-auto">Vớ y khoa điều trị suy giãn tĩnh mạch chất lượng cao, đạt chuẩn áp lực quốc tế.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg px-4 gap-3 fw-bold text-primary">Xem ngay danh mục</a>
    </div>
</div>

<div class="container mb-5">
    <div class="row text-center mb-4">
        <div class="col-md-4">
            <i class="bi bi-shield-check text-primary fs-1"></i>
            <h4 class="mt-2">Đạt Chuẩn Y Tế</h4>
            <p class="text-muted">Áp lực giảm dần chính xác theo khuyến cáo y khoa.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-truck text-primary fs-1"></i>
            <h4 class="mt-2">Giao Hàng Toàn Quốc</h4>
            <p class="text-muted">Kiểm tra hàng trước khi thanh toán.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-headset text-primary fs-1"></i>
            <h4 class="mt-2">Tư Vấn Chọn Size</h4>
            <p class="text-muted">Hỗ trợ đo size chính xác chuẩn theo vòng bắp chân.</p>
        </div>
    </div>

    <h3 class="border-bottom pb-2 mb-4 text-primary">Sản phẩm nổi bật</h3>
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @if (!Model.Products.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <p>Chưa có sản phẩm nào từ hệ thống Backend.</p>
            </div>
        }
        else
        {
            @foreach (var p in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : p.ImageUrl)" class="card-img-top p-3" alt="@p.Name" style="height: 220px; object-fit: contain;">
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary mb-2 align-self-start">@(p.CategoryName ?? "Y khoa")</span>
                            <h6 class="card-title fw-bold">@p.Name</h6>
                            <div class="mt-auto pt-2">
                                <div class="text-danger fw-bold fs-5">@p.Price.ToString("N0") ₫</div>
                                @if (p.DiscountPrice.HasValue && p.DiscountPrice < p.Price)
                                {
                                    <div class="text-muted text-decoration-line-through small">@p.DiscountPrice.Value.ToString("N0") ₫</div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="btn btn-outline-primary w-100">Chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>