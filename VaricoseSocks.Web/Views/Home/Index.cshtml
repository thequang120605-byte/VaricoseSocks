@model VaricoseSocks.Web.Models.ProductListViewModel
@{
    ViewData["Title"] = "Trang chủ - Vớ Y Khoa Chuyên Biệt Điều Trị Suy Giãn Tĩnh Mạch";
}

<!-- Hero Banner Section -->
<div class="bg-primary text-white py-5 shadow-sm mb-5" style="background: linear-gradient(135deg, #0d6efd 0%, #0043a8 100%);">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                    <i class="bi bi-patch-check-fill me-1"></i> Chuẩn Áp Lực Y Khoa Quốc Tế RAL-GZ 387
                </span>
                <h1 class="display-5 fw-bold mb-3">GIẢI PHÁP TOÀN DIỆN CHO ĐÔI CHÂN SUY GIÃN TĨNH MẠCH</h1>
                <p class="lead mb-4 text-white-50">
                    Phục hồi van tĩnh mạch, giảm nhanh cảm giác nặng mỏi, tê bì và sưng phù mắt cá chân với các thương hiệu vớ y tế hàng đầu từ Đức, Mỹ, Ý.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg px-4 fw-bold text-dark shadow">
                        <i class="bi bi-bag-check-fill me-2"></i> Mua Ngay
                    </a>
                    <button type="button" class="btn btn-outline-light btn-lg px-4 fw-semibold" onclick="openChatbot()">
                        <i class="bi bi-robot me-2 text-warning"></i> AI Bác Sĩ Tư Vấn Cấp Độ Vớ
                    </button>
                    <button type="button" class="btn btn-link text-white text-decoration-none d-flex align-items-center" onclick="openSizeModal()">
                        <i class="bi bi-rulers fs-4 me-2"></i> Hướng dẫn đo size
                    </button>
                </div>
            </div>
            <div class="col-lg-5 text-center mt-4 mt-lg-0">
                <img src="https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?w=600" alt="Vớ y khoa giãn tĩnh mạch" class="img-fluid rounded-4 shadow-lg border border-4 border-white-50" style="max-height: 380px; object-fit: cover;" />
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <!-- Trust Features Row -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3 text-center">
                <i class="bi bi-shield-check text-primary fs-1 mb-2"></i>
                <h5 class="fw-bold">Chuẩn Y Tế Đức</h5>
                <p class="text-muted small mb-0">Áp lực giảm dần đúng chuẩn RAL, được bác sĩ chuyên khoa tim mạch khuyên dùng.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3 text-center">
                <i class="bi bi-truck text-primary fs-1 mb-2"></i>
                <h5 class="fw-bold">Giao Hàng Miễn Phí</h5>
                <p class="text-muted small mb-0">Miễn phí vận chuyển toàn quốc cho đơn từ 500k. Nhận hàng kiểm tra thanh toán (COD).</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3 text-center">
                <i class="bi bi-robot text-primary fs-1 mb-2"></i>
                <h5 class="fw-bold">Trợ Lý AI Đo Size</h5>
                <p class="text-muted small mb-0">Tự động chẩn đoán triệu chứng chân và tính size chính xác 100% theo chu vi cổ chân.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3 text-center">
                <i class="bi bi-arrow-repeat text-primary fs-1 mb-2"></i>
                <h5 class="fw-bold">Đổi Size Trong 7 Ngày</h5>
                <p class="text-muted small mb-0">Hỗ trợ đổi size linh hoạt nếu mang không vừa, đảm bảo điều trị hiệu quả và thoải mái nhất.</p>
            </div>
        </div>
    </div>

    <!-- Quick Symptom Assessment Banner -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-danger-subtle text-danger fw-bold mb-2">TƯ VẤN NHANH</span>
                <h4 class="fw-bold text-dark">Bạn đang gặp triệu chứng nào ở đôi chân?</h4>
                <p class="text-muted small mb-3">Chọn đúng tình trạng của bạn để hệ thống lọc ngay cấp độ áp lực y khoa (CCL) tương ứng:</p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Product" asp-action="Index" asp-route-compression="1" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-check-circle me-1"></i> Mỏi phù chân cuối ngày, đứng nhiều (CCL1)
                    </a>
                    <a asp-controller="Product" asp-action="Index" asp-route-compression="2" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-check-circle me-1"></i> Nổi gân xanh bắp chân, phù mắt cá (CCL2)
                    </a>
                    <a asp-controller="Product" asp-action="Index" asp-route-compression="3" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-check-circle me-1"></i> Sưng to kéo dài, huyết khối sâu (CCL3)
                    </a>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="btn btn-outline-success btn-sm rounded-pill px-3">
                        <i class="bi bi-heart me-1"></i> Mẹ bầu bị chuột rút & nặng chân
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center mt-3 mt-lg-0 border-start ps-lg-4">
                <div class="fw-bold text-primary mb-2">Chưa rõ số đo bắp chân của mình?</div>
                <button type="button" class="btn btn-primary w-100 fw-bold py-2 shadow-sm" onclick="openSizeModal()">
                    <i class="bi bi-rulers me-2"></i> Bấm Tra Cứu Bảng Đo Size
                </button>
            </div>
        </div>
    </div>

    <!-- Categories Highlights -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">Danh Mục Vớ Y Khoa</h3>
            <p class="text-muted small mb-0">Các dòng vớ thiết kế theo chuẩn áp lực y tế giảm dần</p>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm fw-semibold">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row row-cols-2 row-cols-md-5 g-3 mb-5">
        @foreach (var c in Model.Categories)
        {
            <div class="col">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm text-center p-3 category-card transition-hover">
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-heart-pulse text-primary fs-3"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">@c.Name</h6>
                        <small class="text-muted" style="font-size: 0.75rem;">@c.Description</small>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- Featured Products Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">Sản Phẩm Vớ Y Khoa Nổi Bật</h3>
            <p class="text-muted small mb-0">Top vớ điều trị suy giãn tĩnh mạch bán chạy nhất đạt kiểm định y tế</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Product" asp-action="Index" asp-route-compression="1" class="btn btn-sm btn-light border">CCL1</a>
            <a asp-controller="Product" asp-action="Index" asp-route-compression="2" class="btn btn-sm btn-light border">CCL2</a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
        @foreach (var p in Model.Products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 product-card position-relative">
                    <!-- Badges -->
                    <div class="position-absolute top-0 start-0 m-2 d-flex flex-column gap-1" style="z-index: 2;">
                        <span class="badge bg-primary">@p.CompressionLevelText</span>
                        @if (p.DiscountPrice.HasValue && p.DiscountPrice < p.Price)
                        {
                            <span class="badge bg-danger">Giảm @(((p.Price - p.DiscountPrice.Value) / p.Price * 100).ToString("F0"))%</span>
                        }
                    </div>

                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="text-center p-3 bg-white d-block">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/300x300?text=No+Image" : p.ImageUrl)" 
                             class="card-img-top" alt="@p.Name" style="height: 200px; object-fit: contain;">
                    </a>

                    <div class="card-body d-flex flex-column pt-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">@(p.CategoryName ?? "Y khoa")</span>
                            <small class="text-muted fw-bold">@(p.Origin ?? "Mỹ/Đức")</small>
                        </div>
                        <h6 class="card-title fw-bold">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                                @p.Name
                            </a>
                        </h6>
                        <p class="small text-muted mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @p.ShortDescription
                        </p>

                        <div class="mt-auto">
                            <div class="d-flex align-items-baseline gap-2 mb-2">
                                <span class="text-danger fw-bold fs-5">
                                    @((p.DiscountPrice ?? p.Price).ToString("N0")) ₫
                                </span>
                                @if (p.DiscountPrice.HasValue && p.DiscountPrice < p.Price)
                                {
                                    <span class="text-muted text-decoration-line-through small">
                                        @p.Price.ToString("N0") ₫
                                    </span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm flex-grow-1">
                                    Chi tiết
                                </a>
                                <button type="button" class="btn btn-warning btn-sm text-dark fw-bold px-3" onclick="addToCartLive(@p.Id, 'M', 'Màu Da (Beige)', 1)">
                                    <i class="bi bi-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Medical Education Info Section -->
    <div class="card border-0 bg-white shadow-sm rounded-4 p-4 p-md-5 mb-5">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge bg-primary-subtle text-primary fw-bold mb-2">CƠ CHẾ Y HỌC</span>
                <h3 class="fw-bold text-dark">Tại sao Vớ Y Khoa có thể điều trị Suy Giãn Tĩnh Mạch?</h3>
                <p class="text-secondary">
                    Khác với tất vớ thông thường, <strong>vớ y khoa giãn tĩnh mạch (Graduated Compression Stockings)</strong> áp dụng nguyên lý tạo lực nén giảm dần chính xác theo tiêu chuẩn y tế quốc tế:
                </p>
                <ul class="list-unstyled text-secondary">
                    <li class="mb-2"><i class="bi bi-check2-circle text-primary me-2"></i><strong>100% áp lực tại cổ chân:</strong> Là nơi áp lực thủy tĩnh cao nhất, giúp khép kín các van tĩnh mạch bị giãn.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-primary me-2"></i><strong>70% áp lực tại bắp chân:</strong> Thúc đẩy lưu lượng dòng máu tĩnh mạch chảy ngược về tim.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-primary me-2"></i><strong>40% áp lực tại đùi:</strong> Hạn chế ứ trệ máu, ngăn chặn nguy cơ hình thành cục máu đông (DVT).</li>
                </ul>
            </div>
            <div class="col-lg-6 text-center">
                <div class="bg-light p-4 rounded-4 border">
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-speedometer me-2"></i>Phân Loại Cấp Độ Áp Lực CCL</h5>
                    <div class="text-start small">
                        <div class="p-2 border-bottom"><strong>CCL1 (15 - 21 mmHg):</strong> Phòng ngừa, cảm giác mỏi chân, phụ nữ có thai, người đứng nhiều.</div>
                        <div class="p-2 border-bottom"><strong>CCL2 (23 - 32 mmHg):</strong> Điều trị giãn tĩnh mạch rõ rệt, sưng phù chân, sau can thiệp xơ hóa.</div>
                        <div class="p-2"><strong>CCL3 (34 - 46 mmHg):</strong> Suy tĩnh mạch nặng, loạn dưỡng mô da hoặc loét chân đã lành.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>